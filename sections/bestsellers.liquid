<section class="section bestsellers">
  <div class="container">
    <p class="eyebrow text-center">{{ section.settings.eyebrow }}</p>
    {%- if section.settings.subheading != blank -%}<p class="section-sub" style="margin-top:0">{{ section.settings.subheading }}</p>{%- endif -%}

    <div class="bs-wrap">
      <button class="round-btn bs-arrow bs-arrow--prev" data-scroll-prev aria-label="Previous">{% render 'icon', icon: 'arrow-left' %}</button>

      <div class="bs-row" data-scroll>
        {%- assign coll = collections[section.settings.collection] -%}
        {%- if coll != empty and coll.products.size > 0 -%}
          {%- for product in coll.products limit: section.settings.limit -%}
            <div class="bs-item">{% render 'product-card', product: product %}</div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="bs-item">
              <div class="product-card">
                <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
                <div class="product-card__body">
                  <h3 class="product-card__title">Product title</h3>
                  <p class="product-card__meta">Variant · Size</p>
                  <span class="product-card__price">₹0</span>
                  <button class="product-card__add">Add to cart</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button class="round-btn bs-arrow bs-arrow--next" data-scroll-next aria-label="Next">{% render 'icon', icon: 'arrow-right' %}</button>
    </div>
  </div>
</section>

<style>
/* ===========================
   BESTSELLERS
=========================== */

.bestsellers{
    padding:90px 0;
}

.bestsellers .container{
    max-width:1152px;
    margin:auto;
}

.bestsellers .eyebrow{
    text-align:center;
    font-size:13px;
    letter-spacing:5px;
    text-transform:uppercase;
    color:#8d7966;
    margin-bottom:10px;
    font-weight:500;
}

.bestsellers .section-sub{
    text-align:center;
    font-size:15px;
    letter-spacing:3px;
    text-transform:uppercase;
    color:#8d7966;
    margin-bottom:55px;
}

.bs-wrap{
    position:relative;
}

.bs-row{
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:calc((100% - 80px)/3);
    gap:40px;

    overflow-x:auto;
    scroll-behavior:smooth;
    scrollbar-width:none;
}

.bs-row::-webkit-scrollbar{
    display:none;
}

.bs-item{
    display:flex;
}

/* PRODUCT CARD */

.product-card{
    width:100%;
    background:transparent;
    border:none;
    padding:0;
}

.product-card__media{
    position:relative;
    overflow:hidden;
    border-radius:48px;
    aspect-ratio:0.72;
    background:#f5f3ef;
}

.product-card__media img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.45s ease;
}

.product-card:hover .product-card__media img{
    transform:scale(1.03);
}

.product-card__body{
    padding:18px 2px 0;
}

.product-card__title{
    font-size:20px;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:8px;
}

.product-card__meta{
    font-size:13px;
    color:#8c8c8c;
    line-height:1.5;
    margin-bottom:18px;
}

.product-card__price{
    display:block;
    font-size:28px;
    margin-bottom:24px;
    font-weight:500;
}

/* BUTTON */

.product-card__add{

    width:100%;
    height:56px;

    border:1px solid #b39b7d;

    background:transparent;

    text-transform:uppercase;

    letter-spacing:3px;

    transition:.3s;
}

.product-card__add:hover{

    background:#5f5246;

    color:#fff;

}

/* HEART */

.product-card .wishlist-button,
.product-card .card__badge,
.product-card .card__wishlist{

    position:absolute;

    top:16px;

    right:16px;

}

/* ARROWS */

.bs-arrow{

    width:56px;

    height:56px;

    border:1px solid #8d7966;

    border-radius:999px;

    background:#fff;

    display:flex;

    align-items:center;

    justify-content:center;

    position:absolute;

    top:40%;

    transform:translateY(-50%);

    transition:.3s;

    z-index:10;

}

.bs-arrow svg{

    width:18px;

    height:18px;

}

.bs-arrow:hover{

    background:#8d7966;

    color:#fff;

}

.bs-arrow--prev{

    left:-70px;

}

.bs-arrow--next{

    right:-70px;

}

/* RESPONSIVE */

@media(max-width:990px){

.bs-row{

grid-auto-columns:80%;

gap:24px;

}

.bs-arrow{

display:none;

}

}

@media(max-width:768px){

.bs-row{

grid-auto-columns:92%;

}

.bestsellers{

padding:70px 0;

}

}
</style>

<script>
  document.querySelectorAll('.bestsellers').forEach(function(sec){
    var row = sec.querySelector('[data-scroll]');
    sec.querySelector('[data-scroll-next]')?.addEventListener('click', function(){ row.scrollBy({left: row.clientWidth/3 + 30, behavior:'smooth'}); });
    sec.querySelector('[data-scroll-prev]')?.addEventListener('click', function(){ row.scrollBy({left: -(row.clientWidth/3 + 30), behavior:'smooth'}); });
  });
</script>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Loved by 1,200+ homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Bestsellers" }]
}
{% endschema %}
