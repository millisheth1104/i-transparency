{%- comment -%}
  Left-column list of sibling mega-menu-enabled nav items (the top-level
  parent categories row, e.g. Bedsheets / Bed Covers / Comforters / ...).
  Plain navigational links -- clicking one goes to that collection's own
  page rather than swapping this menu's content, so each mega menu instance
  only ever has to resolve its own collection's metafields (no querying
  every sibling parent's sub-collections/products on every page load).
  params: all_links (native menu links array), current_collection (Collection)
{%- endcomment -%}
<ul class="mega-menu__list mega-menu__list--parent" data-mega-parentlist>
  {%- for link in all_links -%}
    {%- assign sibling_subs = link.object.metafields.custom.sub_collections.value -%}
    {%- if sibling_subs != blank and sibling_subs.size > 0 -%}
      <li>
        <a href="{{ link.url }}"
           class="mega-menu__list-link{% if link.object.handle == current_collection.handle %} is-active{% endif %}">{{ link.title }}</a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
