<section class="hero">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.heading | escape }}" width="2400" height="1200" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {%- endif -%}
    <div class="hero__scrim"></div>
    <button class="round-btn hero__next" aria-label="Explore" data-hero-next>{% render 'icon', icon: 'arrow-right' %}</button>

    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label_1 != blank -%}
          <a class="btn" href="{{ section.settings.button_link_1 }}">{{ section.settings.button_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_trust -%}
    <div class="trust-bar">
      {%- assign items = section.settings.trust_items | split: '|' -%}
      {%- assign trust_icons = 'box|refresh|cash|truck' | split: '|' -%}
      {%- for item in items -%}
        <span class="trust-bar__item">
          {%- assign icon_index = forloop.index0 | modulo: trust_icons.size -%}
          {% render 'icon', icon: trust_icons[icon_index] %}
          {{ item | strip }}
        </span>
        {%- unless forloop.last -%}<span class="trust-bar__sep"></span>{%- endunless -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
 /* ===========================
   BESTSELLERS
=========================== */
.bestsellers{
    padding:90px 0;
}
.bestsellers .container{
    max-width:1152px;
    margin:auto;
}
.bestsellers .eyebrow{
    text-align:center;
    font-size:13px;
    letter-spacing:5px;
    text-transform:uppercase;
    color:#8d7966;
    margin-bottom:10px;
    font-weight:500;
}
.bestsellers .section-sub{
    text-align:center;
    font-size:15px;
    letter-spacing:3px;
    text-transform:uppercase;
    color:#8d7966;
    margin-bottom:55px;
}
.bs-wrap{
    position:relative;
}
.bs-row{
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:calc((100% - 80px)/3);
    gap:40px;
    overflow-x:auto;
    scroll-behavior:smooth;
    scrollbar-width:none;
}
.bs-row::-webkit-scrollbar{
    display:none;
}
.bs-item{
    display:flex;
}
/* PRODUCT CARD */
.product-card{
    width:100%;
    background:transparent;
    border:none;
    padding:0;
}
.product-card__media{
    position:relative;
    overflow:hidden;
    border-radius:18px;
    aspect-ratio:0.72;
    background:#f5f3ef;
}
.product-card__media img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.45s ease;
}
.product-card:hover .product-card__media img{
    transform:scale(1.03);
}
.product-card__body{
    padding:18px 2px 0;
}
.product-card__title{
    font-size:20px;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:8px;
}
.product-card__meta{
    font-size:13px;
    color:#8c8c8c;
    line-height:1.5;
    margin-bottom:18px;
}
.product-card__price{
    display:block;
    font-size:28px;
    margin-bottom:24px;
    font-weight:500;
}
/* BUTTON */
.product-card__add{
    width:100%;
    height:56px;
    border:1px solid #b39b7d;
    background:transparent;
    text-transform:uppercase;
    letter-spacing:3px;
    transition:.3s;
}
.product-card__add:hover{
    background:#5f5246;
    color:#fff;
}
/* HEART */
.product-card .wishlist-button,
.product-card .card__badge,
.product-card .card__wishlist{
    position:absolute;
    top:16px;
    right:16px;
}
/* ARROWS */
.bs-arrow{
    width:56px;
    height:56px;
    border:1px solid #8d7966;
    border-radius:999px;
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    position:absolute;
    top:40%;
    transform:translateY(-50%);
    transition:.3s;
    z-index:10;
}
.bs-arrow svg{
    width:18px;
    height:18px;
}
.bs-arrow:hover{
    background:#8d7966;
    color:#fff;
}
.bs-arrow--prev{
    left:-70px;
}
.bs-arrow--next{
    right:-70px;
}
/* RESPONSIVE */
@media(max-width:990px){
.bs-row{
grid-auto-columns:80%;
gap:24px;
}
.bs-arrow{
display:none;
}
}
@media(max-width:768px){
.bs-row{
grid-auto-columns:92%;
}
.bestsellers{
padding:70px 0;
}}
</style>

<script>
  document.querySelectorAll('[data-hero-next]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var wrap = btn.closest('.shopify-section');
      var next = wrap ? wrap.nextElementSibling : null;
      if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bespoke Bedding · 100% Cotton · Exquisite Craftsmanship" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The art of <em>sleep.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Designed to transform your bedroom into a quiet sanctuary of restful serenity." },
    { "type": "text", "id": "button_label_1", "label": "Button 1 label", "default": "Shop by category" },
    { "type": "url", "id": "button_link_1", "label": "Button 1 link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 label", "default": "Featured collections" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 link" },
    { "type": "header", "content": "Trust bar" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust bar", "default": true },
    { "type": "text", "id": "trust_items", "label": "Items (separate with |)", "default": "Free delivery | 7 day returns | Cash on delivery available | Delivered in 48 hours" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
