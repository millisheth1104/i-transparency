{% doc %}
  @prompt
    {% comment %}
      SECTION: Collection Categories Grid
      Features:
      - as many i want to add i can
      - Select collection from Theme Editor
      - Optional custom image override per collection
      - Optional custom page link override per collection
      - Fully responsive
      - Hover effect
      - Entire card clickable
    {% endcomment %}
    
    <section class="collection-categories-section">
      <div class="collection-categories-wrapper">
    
        {% for block in section.blocks %}
          {% assign collection = collections[block.settings.collection] %}
    
          <a
            href="{{ collection.url }}"
            class="collection-category-card"
            {{ block.shopify_attributes }}
          >
    
            <div class="collection-category-image-wrapper">
    
              {% if block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 800 }}"
                  alt="{{ collection.title }}"
                  loading="lazy"
                  class="collection-category-image"
                >
              {% elsif collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.title }}"
                  loading="lazy"
                  class="collection-category-image"
                >
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
    
            </div>
    
            <div class="collection-category-content">
              <h3 class="collection-category-title">
                {{ collection.title }}
              </h3>
            </div>
    
          </a>
        {% endfor %}
    
      </div>
    </section>
    
    <style>
    .collection-categories-section {
      padding: 60px 20px;
    }
    
    .collection-categories-wrapper {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 20px;
      max-width: 1600px;
      margin: 0 auto;
    }
    
    .collection-category-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: #fff;
      border-radius: 14px;
      overflow: hidden;
      transition: all 0.35s ease;
      position: relative;
    }
    
    .collection-category-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }
    
    .collection-category-image-wrapper {
      position: relative;
      width: 100%;
      padding-top: 100%;
      overflow: hidden;
      background: #f5f5f5;
    }
    
    .collection-category-image,
    .collection-category-image-wrapper img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .collection-category-content {
      padding: 16px;
      text-align: center;
    }
    
    .collection-category-title {
      margin: 0;
      font-size: 18px;
      font-weight: 600;
      line-height: 1.3;
    }
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: all 0.35s ease;
    position: relative;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2.5 }}px rgba(0,0,0,{{ block.settings.shadow_opacity }});
  }

  .ai-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background: {{ block.settings.placeholder_background }};
  }

  .ai-collection-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_zoom }});
  }

  .ai-collection-image-wrapper-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    line-height: 1.3;
    color: {{ block.settings.title_color }};
  }

  .ai-collection-count-{{ ai_gen_id }} {
    margin-top: 8px;
    font-size: {{ block.settings.count_size }}px;
    color: {{ block.settings.count_color }};
    opacity: 0.8;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }
  }
{% endstyle %}

<collection-categories-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-wrapper-{{ ai_gen_id }}">
    {% for block in section.blocks %}
      {% liquid
        if block.settings.collection != blank
          assign collection = block.settings.collection
        else
          assign collection = null
        endif

        if block.settings.custom_link != blank
          assign card_url = block.settings.custom_link
        elsif collection
          assign card_url = collection.url
        else
          assign card_url = '#'
        endif
      %}

      <a
        href="{{ card_url }}"
        class="ai-collection-card-{{ ai_gen_id }}"
        {{ block.shopify_attributes }}
      >
        <div class="ai-collection-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.custom_image != blank %}
            <img
              src="{{ block.settings.custom_image | image_url: width: 800 }}"
              alt="{{ block.settings.custom_image.alt | default: collection.title | escape }}"
              loading="lazy"
              class="ai-collection-image-{{ ai_gen_id }}"
              width="800"
              height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
            >
          {% elsif collection and collection.featured_image %}
            <img
              src="{{ collection.featured_image | image_url: width: 800 }}"
              alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
              loading="lazy"
              class="ai-collection-image-{{ ai_gen_id }}"
              width="800"
              height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
            >
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag }}
          {% endif %}
        </div>

        <div class="ai-collection-content-{{ ai_gen_id }}">
          {% if collection %}
            <h3 class="ai-collection-title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h3>
            {% if block.settings.show_product_count %}
              <p class="ai-collection-count-{{ ai_gen_id }}">
                {{ collection.products_count }}
                {% if collection.products_count == 1 %}
                  product
                {% else %}
                  products
                {% endif %}
              </p>
            {% endif %}
          {% else %}
            <h3 class="ai-collection-title-{{ ai_gen_id }}">
              Collection title
            </h3>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</collection-categories-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCategoriesGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-collection-card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              card.click();
            }
          });
        });
      }
    }

    customElements.define('collection-categories-grid-{{ ai_gen_id }}', CollectionCategoriesGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Card content padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "hover_lift",
      "label": "Hover lift",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "range",
      "id": "hover_shadow",
      "label": "Hover shadow",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.1
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Image zoom on hover",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f7f2ea"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "placeholder_background",
      "label": "Placeholder background",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#5a5148"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5a5148"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": false
    },
    {
      "type": "range",
      "id": "count_size",
      "label": "Product count size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "count_color",
      "label": "Product count color",
      "default": "#5a5148"
    }
  ],
  "presets": [
    {
      "name": "Collection grid"
    }
  ]
}
{% endschema %}
