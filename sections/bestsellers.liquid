<section class="section bestsellers">
  <div class="container">
    <p class="eyebrow text-center">{{ section.settings.eyebrow }}</p>
    {%- if section.settings.subheading != blank -%}<p class="section-sub" style="margin-top:0">{{ section.settings.subheading }}</p>{%- endif -%}

    <div class="bs-wrap">
      <button class="round-btn bs-arrow bs-arrow--prev" data-scroll-prev aria-label="Previous">{% render 'icon', icon: 'arrow-left' %}</button>

      <div class="bs-row" data-scroll>
        {%- assign coll = collections[section.settings.collection] -%}
        {%- if coll != empty and coll.products.size > 0 -%}
          {%- for product in coll.products limit: section.settings.limit -%}
            <div class="bs-item">{% render 'product-card', product: product %}</div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="bs-item">
              <div class="product-card">
                <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
                <div class="product-card__body">
                  <h3 class="product-card__title">Product title</h3>
                  <p class="product-card__meta">Variant · Size</p>
                  <span class="product-card__price">₹0</span>
                  <button class="product-card__add">Add to cart</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button class="round-btn bs-arrow bs-arrow--next" data-scroll-next aria-label="Next">{% render 'icon', icon: 'arrow-right' %}</button>
    </div>
  </div>
</section>

<style>
/* ===========================
   BESTSELLERS
=========================== */

.bestsellers{
    padding:90px 0;
}

.bestsellers .container{
    max-width:1272px;
    margin:auto;
}

.bestsellers .eyebrow{
    text-align:center;
    font-size:13px;
    letter-spacing:5px;
    text-transform:uppercase;
    color:#8d7966;
    margin-bottom:10px;
    font-weight:500;
}

.bestsellers .section-sub{
    text-align:center;
    font-size:13px;
    letter-spacing:3px;
    text-transform:uppercase;
    color:#a89b8a;
    font-weight:400;
    margin-bottom:40px;
}

.bs-wrap{
    position:relative;
}

.bs-row{
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:calc((100% - 76px)/3);
    gap:38px;
    align-items:start;

    overflow-x:auto;
    scroll-behavior:smooth;
    scrollbar-width:none;
}

.bs-row::-webkit-scrollbar{
    display:none;
}

.bs-item{
    display:flex;
}

/* PRODUCT CARD */

.bestsellers .product-card{
    width:100%;
    height:100%;
    background:transparent;
    border:none;
    padding:0;
    display:flex;
    flex-direction:column;
}

.bestsellers .product-card__media{
    position:relative;
    overflow:hidden;
    border-radius:18px;
    aspect-ratio:3/4;
    background:#f5f3ef;
    padding:0;
    display:block;
}

.bestsellers .product-card__media img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .45s ease;
}

.bestsellers .product-card:hover .product-card__media img{
    transform:scale(1.03);
}

.bestsellers .product-card__body{
    padding:16px 0 0;
    display:flex;
    flex-direction:column;
    flex:1;
}

.bestsellers .product-card__title{
    font-size:21px;
    font-weight:500;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:6px;
    line-height:1.3;
}

.bestsellers .product-card__meta{
    font-size:12px;
    letter-spacing:.3px;
    color:#8c8c8c;
    line-height:1.5;
    margin:0;
}

.bestsellers .product-card__meta:first-of-type{
    color:#5f5246;
}

.bestsellers .product-card__price{
    display:block;
    font-size:19px;
    font-weight:500;
    margin:10px 0 16px;
}

/* pins price+button to a shared baseline regardless of how many meta lines a card has */
.bestsellers .product-card__price{
    margin-top:auto;
}

/* BUTTON */

.bestsellers .product-card__add{
    width:100%;
    height:52px;
    border:1px solid #b39b7d;
    background:transparent;
    text-transform:uppercase;
    letter-spacing:3px;
    font-size:13px;
    transition:.3s;
}

.bestsellers .product-card__add:hover{
    background:#5f5246;
    color:#fff;
    border-color:#5f5246;
}

.bestsellers .product-card__add[disabled]{
    opacity:.6;
    cursor:default;
}

/* HEART */

.bestsellers .product-card__wish{
    position:absolute;
    top:14px;
    right:14px;
    background:none;
    border:none;
    padding:0;
    color:#5f5246;
}

.bestsellers .product-card__wish svg{
    width:18px;
    height:18px;
}

/* ARROWS */

.bs-arrow{

    width:48px;

    height:48px;

    border:1px solid #8d7966;

    border-radius:999px;

    background:#fff;

    display:flex;

    align-items:center;

    justify-content:center;

    position:absolute;

    top:0;

    transition:.3s;

    z-index:10;

}

.bs-arrow svg{

    width:16px;

    height:16px;

}

.bs-arrow:hover{

    background:#f2ece2;

}

.bs-arrow--prev{

    left:-60px;

}

.bs-arrow--next{

    right:-60px;

}

/* RESPONSIVE */

@media(max-width:990px){

.bs-row{

grid-auto-columns:80%;

gap:24px;

}

.bs-arrow{

display:none;

}

}

@media(max-width:768px){

.bs-row{

grid-auto-columns:92%;

}

.bestsellers{

padding:70px 0;

}

}
</style>

<script>
  document.querySelectorAll('.bestsellers').forEach(function(sec){
    var row = sec.querySelector('[data-scroll]');
    var wrap = sec.querySelector('.bs-wrap');
    var prev = sec.querySelector('[data-scroll-prev]');
    var next = sec.querySelector('[data-scroll-next]');
    prev?.addEventListener('click', function(){ row.scrollBy({left: -(row.clientWidth/3 + 30), behavior:'smooth'}); });
    next?.addEventListener('click', function(){ row.scrollBy({left: row.clientWidth/3 + 30, behavior:'smooth'}); });

    function alignArrows(){
      var media = sec.querySelector('.product-card__media');
      if (!media || !wrap) return;
      var top = media.offsetHeight / 2 - 24;
      if (prev) prev.style.top = top + 'px';
      if (next) next.style.top = top + 'px';
    }
    alignArrows();
    window.addEventListener('resize', alignArrows);
  });
</script>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Loved by 1,200+ homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Bestsellers" }]
}
{% endschema %}
