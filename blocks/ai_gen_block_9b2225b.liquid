{% doc %}
  @prompt
    {% comment %}
      SECTION: Collection Categories Grid
      Features:
      - Section heading (eyebrow + title + subtitle) from Theme Editor
      - Numbered collection cards with overlay title/count
      - Select collection from Theme Editor
      - Optional custom image override per collection
      - Optional custom page link override per collection
      - Fully responsive (3-column grid)
      - Hover effect
      - Entire card clickable
    {% endcomment %}
    
    <section class="collection-categories-section">
      <div class="collection-categories-header">
        {% if section.settings.eyebrow != blank %}
          <p class="collection-categories-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
    
        {% if section.settings.heading != blank %}
          <h2 class="collection-categories-heading">{{ section.settings.heading }}</h2>
        {% endif %}
    
        {% if section.settings.subheading != blank %}
          <p class="collection-categories-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    
      <div class="collection-categories-wrapper">
        {% for block in section.blocks %}
          {% assign collection = collections[block.settings.collection] %}
          {% assign index = forloop.index | prepend: '00' | slice: -2, 2 %}
    
          <div class="collection-category-card" {{ block.shopify_attributes }}>
            <a href="{{ collection.url }}" class="collection-category-image-wrapper">
              {% if block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 800 }}"
                  alt="{{ collection.title }}"
                  loading="lazy"
                  class="collection-category-image"
                >
              {% elsif collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.title }}"
                  loading="lazy"
                  class="collection-category-image"
                >
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
    
              <div class="collection-category-overlay">
                <span class="collection-category-index">/{{ index }}</span>
                <h3 class="collection-category-title">{{ collection.title }}</h3>
                <span class="collection-category-count">{{ collection.all_products_count }} PRODUCTS</span>
              </div>
            </a>
    
            <a href="{{ collection.url }}" class="collection-category-link">
              VIEW COLLECTION
              <span class="collection-category-arrow">&rarr;</span>
            </a>
          </div>
        {% endfor %}
      </div>
    </section>
    
    <style>
    .collection-categories-section {
      padding: 60px 20px;
      background: #f2f1ee;
    }
    
    .collection-categories-header {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 40px;
    }
    
    .collection-categories-eyebrow {
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #8a8a86;
      margin: 0 0 12px;
    }
    
    .collection-categories-heading {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 36px;
      font-weight: 400;
      color: #2b2b28;
      margin: 0 0 14px;
    }
    
    .collection-categories-heading em {
      font-style: italic;
    }
    
    .collection-categories-subheading {
      font-size: 14px;
      line-height: 1.6;
      color: #6f6f6b;
      margin: 0;
    }
    
    .collection-categories-wrapper {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      max-width: 1400px;
      margin: 0 auto;
    }
    
    .collection-category-card {
      display: flex;
      flex-direction: column;
    }
    
    .collection-category-image-wrapper {
      position: relative;
      display: block;
      width: 100%;
      padding-top: 128%;
      overflow: hidden;
      border-radius: 4px;
      background: #e4e2dd;
      text-decoration: none;
    }
    
    .collection-category-image,
    .collection-category-image-wrapper img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    
    .collection-category-card:hover .collection-category-image {
      transform: scale(1.04);
    }
    
    .collection-category-overlay {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      padding: 22px;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 60%);
      color: #fff;
      box-sizing: border-box;
    }
    
    .collection-category-index {
      display: block;
      font-size: 12px;
      letter-spacing: 1px;
      opacity: 0.85;
      margin-bottom: 4px;
    }
    
    .collection-category-title {
      margin: 0 0 6px;
      font-family: var(--font-serif)
      font-style: italic;
      font-size: 22px;
      font-weight: 400;
      color: #fff;
      text-transform: lowercase;
    }
    
    .collection-category-count {
      display: block;
      font-size: 11px;
      letter-spacing: 1.5px;
      opacity: 0.85;
    }
    
    .collection-category-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 14px;
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #2b2b28;
      text-decoration: none;
    }
    
    .collection-category-arrow {
      transition: transform 0.25s ease;
    }
    
