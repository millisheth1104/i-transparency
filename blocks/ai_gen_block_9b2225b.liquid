{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-grid-header-{{ ai_gen_id }} {
    text-align: center;
    max-width: 640px;
    margin: 0 auto {{ block.settings.header_spacing }}px;
  }

  .ai-collection-grid-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin: 0 0 12px;
  }

  .ai-collection-grid-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 400;
    color: {{ block.settings.heading_color }};
    margin: 0 0 14px;
  }

  .ai-collection-grid-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.6;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-collection-grid-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-collection-grid-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: 100%;
    padding-top: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.placeholder_bg_color }};
    text-decoration: none;
  }

  .ai-collection-grid-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-collection-grid-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  {% if block.settings.enable_hover_zoom %}
    .ai-collection-grid-card-{{ ai_gen_id }}:hover .ai-collection-grid-image-{{ ai_gen_id }} {
      transform: scale(1.04);
    }
  {% endif %}

  .ai-collection-grid-overlay-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 22px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 0%, rgba(0, 0, 0, 0) 60%);
    color: {{ block.settings.overlay_text_color }};
    box-sizing: border-box;
  }

  .ai-collection-grid-index-{{ ai_gen_id }} {
    display: block;
    font-size: 12px;
    letter-spacing: 1px;
    opacity: 0.85;
    margin-bottom: 4px;
  }

  .ai-collection-grid-title-{{ ai_gen_id }} {
    margin: 0 0 6px;
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 400;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-collection-grid-count-{{ ai_gen_id }} {
    display: block;
    font-size: 11px;
    letter-spacing: 1.5px;
    opacity: 0.85;
  }

  .ai-collection-grid-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-collection-grid-arrow-{{ ai_gen_id }} {
    transition: transform 0.25s ease;
  }

  .ai-collection-grid-link-{{ ai_gen_id }}:hover .ai-collection-grid-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  @media screen and (max-width: 989px) {
    .ai-collection-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-grid-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-collection-grid-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-collection-grid-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-collection-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-collection-grid-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-collection-grid-wrapper-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign custom_image_key = 'custom_image_' | append: i
        assign custom_link_key = 'custom_link_' | append: i
        assign show_card_key = 'show_card_' | append: i

        assign collection = block.settings[collection_key]
        assign custom_image = block.settings[custom_image_key]
        assign custom_link = block.settings[custom_link_key]
        assign show_card = block.settings[show_card_key]

        if custom_link != blank
          assign card_url = custom_link
        elsif collection
          assign card_url = collection.url
        else
          assign card_url = '#'
        endif

        assign index = i | prepend: '00' | slice: -2, 2
      %}

      {% if show_card %}
        <div class="ai-collection-grid-card-{{ ai_gen_id }}">
          <a href="{{ card_url }}" class="ai-collection-grid-image-wrapper-{{ ai_gen_id }}">
            {% if custom_image != blank %}
              <img
                src="{{ custom_image | image_url: width: 800 }}"
                alt="{{ collection.title | default: 'Collection' }}"
                loading="lazy"
                class="ai-collection-grid-image-{{ ai_gen_id }}"
                width="800"
                height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
              >
            {% elsif collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.title }}"
                loading="lazy"
                class="ai-collection-grid-image-{{ ai_gen_id }}"
                width="800"
                height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
              >
            {% else %}
              <div class="ai-collection-grid-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.show_overlay %}
              <div class="ai-collection-grid-overlay-{{ ai_gen_id }}">
                {% if block.settings.show_index %}
                  <span class="ai-collection-grid-index-{{ ai_gen_id }}">/{{ index }}</span>
                {% endif %}
                {% if collection %}
                  <h3 class="ai-collection-grid-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                  {% if block.settings.show_product_count %}
                    <span class="ai-collection-grid-count-{{ ai_gen_id }}">{{ collection.all_products_count }} PRODUCTS</span>
                  {% endif %}
                {% else %}
                  <h3 class="ai-collection-grid-title-{{ ai_gen_id }}">Collection {{ i }}</h3>
                {% endif %}
              </div>
            {% endif %}
          </a>

          {% if block.settings.show_view_link %}
            <a href="{{ card_url }}" class="ai-collection-grid-link-{{ ai_gen_id }}">
              {{ block.settings.link_text }}
              <span class="ai-collection-grid-arrow-{{ ai_gen_id }}">&rarr;</span>
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

