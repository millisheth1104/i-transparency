{%- comment -%} Wishlist — client-side via localStorage. All products rendered hidden;
  wishlist.js reveals only saved cards. Matches wishlist tiles. {%- endcomment -%}
<section class="section--tight wishlist-sec" data-wishlist-page>
  <div class="container">
    <div class="wishlist-top">
      <p class="eyebrow wishlist-sec__label">{{ section.settings.label }}</p>
      <div class="wishlist-toolbar" data-wishlist-toolbar hidden>
        <button type="button" class="wishlist-share" data-wishlist-share>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="18" height="18"><circle cx="6" cy="12" r="2.5"/><circle cx="17" cy="6" r="2.5"/><circle cx="17" cy="18" r="2.5"/><path d="M8.3 10.8l6.4-3.6M8.3 13.2l6.4 3.6"/></svg>
          <span>{{ section.settings.share_label }}</span>
        </button>
        <button type="button" class="btn wishlist-moveall" data-wishlist-moveall>{{ section.settings.move_all_label }}</button>
      </div>
    </div>

    <div class="wishlist-wrap" data-wishlist-grid hidden>
      <div class="wishlist-row" data-wishlist-row>
        {%- assign coll = collections[section.settings.collection] -%}
        {%- if coll != empty and coll.products.size > 0 -%}
          {%- assign source_coll = coll -%}
        {%- else -%}
          {%- assign source_coll = collections.all -%}
        {%- endif -%}
        {%- comment -%}
          collection.products is silently capped at 50 items unless
          wrapped in {% paginate %} — that cap, not max_products, is why
          products beyond the first 50 in the store never got a card
          here at all. paginate's "by" must be a literal number (not a
          setting variable), so this is hardcoded to Shopify's own hard
          maximum for that tag, which comfortably covers the catalog.
        {%- endcomment -%}
        {%- paginate source_coll.products by 250 -%}
          {%- for product in source_coll.products limit: section.settings.max_products -%}
            <div class="wishlist-item" data-wishlist-card="{{ product.id }}" hidden>
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        {%- endpaginate -%}
      </div>
    </div>

    <div class="wishlist-empty" data-wishlist-empty>
      <h2 class="wishlist-empty__title">Your wishlist is <em>empty</em></h2>
      <p class="wishlist-empty__sub">Tap the heart on any product to save it here.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Explore the collection</a>
    </div>
  </div>
</section>

<script src="{{ 'wishlist.js' | asset_url }}" defer></script>

<style>
  .wishlist-sec { padding-top: 40px; }
  .wishlist-sec .container { max-width: 1272px; margin: auto; }
  .wishlist-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 34px; flex-wrap: wrap; }
  .wishlist-sec__label { margin: 0; }
  .wishlist-toolbar { display: flex; align-items: center; gap: 26px; }
  .wishlist-share { background: transparent; border: none; display: inline-flex; align-items: center; gap: 10px; color: var(--brown); font-family: var(--font-ui); font-size: 12px; letter-spacing: .18em; text-transform: uppercase; }
  .wishlist-share:hover { color: var(--taupe-dark); }
  .wishlist-share.is-copied span::after { content: ' — copied'; color: var(--taupe); }
  .wishlist-moveall { letter-spacing: .18em; }

  .wishlist-wrap { position: relative; }
  .wishlist-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; align-items: start; }
  .wishlist-item { display: flex; }
  .wishlist-item[hidden] { display: none !important; }
  .wishlist-item .product-card { width: 100%; height: 100%; background: transparent; border: none; padding: 0; display: flex; flex-direction: column; }
  .wishlist-item .product-card__media { position: relative; overflow: hidden; border-radius: 18px; aspect-ratio: 3/4; background: #f5f3ef; padding: 0; display: block; }
  .wishlist-item .product-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .wishlist-item .product-card:hover .product-card__media img { transform: scale(1.03); }
  .wishlist-item .product-card__body { padding: 16px 0 0; display: flex; flex-direction: column; flex: 1; }
  .wishlist-item .product-card__title { font-size: 21px; font-weight: 500; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 6px; line-height: 1.3; }
  .wishlist-item .product-card__meta { font-size: 12px; letter-spacing: .3px; color: #8c8c8c; line-height: 1.5; margin: 0; }
  .wishlist-item .product-card__meta:first-of-type { color: #5f5246; }
  .wishlist-item .product-card__price { display: block; font-size: 19px; font-weight: 500; margin: 10px 0 16px; margin-top: auto; }
  .wishlist-item .product-card__add { width: 100%; height: 52px; border: 1px solid #b39b7d; background: transparent; text-transform: uppercase; letter-spacing: 3px; font-size: 13px; transition: .3s; }
  .wishlist-item .product-card__add:hover { background: #5f5246; color: #fff; border-color: #5f5246; }
  .wishlist-item .product-card__add[disabled] { opacity: .6; cursor: default; }
  .wishlist-item .product-card__wish { position: absolute; top: 14px; right: 14px; background: none; border: none; padding: 0; color: #5f5246; }
  .wishlist-item .product-card__wish svg { width: 18px; height: 18px; }

  .wishlist-empty { text-align: center; padding: 70px 0 50px; }
  .wishlist-empty__title { font-size: clamp(28px, 4vw, 44px); }
  .wishlist-empty__title em { font-style: italic; }
  .wishlist-empty__sub { color: var(--muted); margin: 14px 0 28px; }
  @media (max-width: 600px) {
    .wishlist-top { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 990px) {
    .wishlist-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .wishlist-row { grid-template-columns: minmax(0, 1fr); }
  }
</style>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "label", "label": "Page label", "default": "Wishlist" },
    { "type": "text", "id": "share_label", "label": "Share button", "default": "Share wishlist" },
    { "type": "text", "id": "move_all_label", "label": "Move all button", "default": "Move all to cart" },
    { "type": "collection", "id": "collection", "label": "Source collection (defaults to all products)" },
    { "type": "range", "id": "max_products", "label": "Max products to index", "info": "Must be at least your total product count, or wishlisted items beyond this cap won't have a card to show at all. 250 is Shopify's hard maximum here.", "min": 12, "max": 250, "step": 12, "default": 250 }
  ],
  "presets": [{ "name": "Wishlist" }]
}
{% endschema %}
