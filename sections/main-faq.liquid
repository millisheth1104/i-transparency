{%- comment -%} FAQ page — Beds & More by Sarom. Content sourced verbatim from merchant-provided Website Content PDF. {%- endcomment -%}
<section class="faq">
  <div class="container">
    <div class="faq__head">
      <p class="eyebrow">Support</p>
      <h1 class="section-heading">Frequently Asked <em>Questions</em></h1>
      <p class="faq__sub">Everything about orders, delivery, returns and caring for your bedding — in one place.</p>
      <div class="faq__search">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4" stroke-linecap="round"/></svg>
        <input type="search" placeholder="Search the FAQs" aria-label="Search the FAQs" data-faq-search autocomplete="off">
      </div>
      <p class="faq__empty" data-faq-empty hidden>No questions match that search. Try a different word, or <a href="{{ routes.root_url }}pages/contact">ask us directly</a>.</p>
    </div>

    <div class="faq__groups">

      <div class="faq__group">
        <h2 class="faq__group-title">Orders</h2>
        <details class="faq__item" open>
          <summary class="faq__q">How do I know if my order has been confirmed?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Once your order has been successfully placed, you should receive an order confirmation through the email address, mobile number, or other contact information provided when placing your order. Please review the confirmation carefully to ensure that your order and delivery details are correct.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">Can I change my order after placing it?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Orders are processed based on the information submitted at the time of purchase. We therefore cannot guarantee that changes can be made after an order has been placed. Please contact us immediately at <a href="mailto:customercare@sarom.info">customercare@sarom.info</a> if you notice an issue with your order details.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">Can I cancel my order?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>No. Sarom does not accept order cancellations. Once your order has been placed, it cannot be cancelled at the customer's request.</p></div>
        </details>
      </div>

      <div class="faq__group">
        <h2 class="faq__group-title">Shipping &amp; Delivery</h2>
        <details class="faq__item">
          <summary class="faq__q">How long will my order take to arrive?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Delivery times vary depending on the product, delivery location, availability, and courier partner. Please refer to the estimated delivery timeline displayed during your purchase or communicated with your order.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">How do I track my order?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Once your order has been dispatched, tracking details may be sent to the email address or mobile number associated with your order. Please note that tracking information may take some time to become active after dispatch.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">What happens if I enter the wrong delivery address?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Customers are responsible for providing complete and accurate delivery information. If you notice an error, contact <a href="mailto:customercare@sarom.info">customercare@sarom.info</a> as soon as possible. If the order has already been processed or dispatched, we may not be able to change the delivery address. Additional shipping charges may apply if an order needs to be shipped again because incorrect or incomplete delivery information was provided.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">What should I do if my package arrives damaged?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>We recommend taking photographs of the package before opening it if the external packaging appears significantly damaged or tampered with. If the product itself is damaged, contact Sarom Customer Care within 7 days of delivery.</p></div>
        </details>
      </div>

      <div class="faq__group">
        <h2 class="faq__group-title">Returns &amp; Replacements</h2>
        <details class="faq__item">
          <summary class="faq__q">What products can I return?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Sarom accepts returns only if: 1. You received the product in a damaged condition; or 2. You received a product different from what you ordered. Returns for other reasons are not accepted.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">Can I return a product if I change my mind?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>No. We do not accept returns or exchanges due to change of mind, personal preference, colour preference, size, or other reasons unrelated to receiving a damaged or incorrect product.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">How long do I have to report a damaged or incorrect product?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Please contact Sarom Customer Care within 7 days of delivery.</p><p><strong>Email:</strong> <a href="mailto:customercare@sarom.info">customercare@sarom.info</a><br><strong>Phone:</strong> +91-8657944323</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">What information should I provide?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Please provide:</p><ul><li>Your name;</li><li>Order number;</li><li>A description of the issue; and</li><li>Clear photographs and/or videos showing the product, packaging, damage, or incorrect item.</li></ul><p>Our team may request additional information to assess your request.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">Can I use or wash the product before returning it?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>No. A product being returned must remain unused and unwashed, with its original tags, labels, packaging, and accessories intact where applicable.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">Can I exchange my product for another design, colour, or size?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>No. Returns and replacements are only available for eligible damaged or incorrect products and cannot be used to exchange a product based on preference.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">What happens if my replacement is out of stock?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>If your return has been approved but the applicable replacement product is unavailable, our customer care team will contact you regarding an appropriate resolution, which may include a refund.</p></div>
        </details>
      </div>

      <div class="faq__group">
        <h2 class="faq__group-title">Products</h2>
        <details class="faq__item">
          <summary class="faq__q">Will the product colour look exactly like the website?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>We make reasonable efforts to represent product colours accurately. However, colours may appear slightly different depending on your device, screen settings, lighting conditions, and the nature of the material.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">Are variations in fabric considered defects?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Minor variations in weave, texture, colour, pattern placement, or finish may naturally occur in textile products or between different production batches. Reasonable variations of this nature are not automatically considered product damage.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">How should I care for my Sarom products?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Please follow the care instructions provided on the product label, packaging, or applicable product page. Following the recommended care instructions will help preserve the appearance and quality of your product.</p></div>
        </details>
      </div>

      <div class="faq__group">
        <h2 class="faq__group-title">Payments &amp; Privacy</h2>
        <details class="faq__item">
          <summary class="faq__q">Is my payment information secure?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Payments may be processed using authorized third-party payment gateways and financial institutions. You should never send complete card details, passwords, OTPs, or sensitive banking credentials through ordinary email or unsecured communication channels.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">What information does Sarom collect?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>Depending on how you use our website, we may collect information necessary to process orders and provide our services, such as your name, contact information, billing and delivery addresses, order details, and website usage information. Please see our Privacy Policy for more information.</p></div>
        </details>
        <details class="faq__item">
          <summary class="faq__q">Will Sarom sell my personal information?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>No. Sarom does not sell or rent your personal information. Information may be shared with service providers where necessary to process payments, fulfil orders, arrange delivery, operate our website, provide customer service, or meet applicable legal requirements.</p></div>
        </details>
      </div>

      <div class="faq__group">
        <h2 class="faq__group-title">Customer Care</h2>
        <details class="faq__item">
          <summary class="faq__q">How can I contact Sarom?<span class="faq__ico">+</span></summary>
          <div class="faq__a"><p>For questions regarding orders, products, shipping, returns, replacements, or other concerns, please contact:</p><p><strong>Sarom Customer Care</strong><br><strong>Email:</strong> <a href="mailto:customercare@sarom.info">customercare@sarom.info</a><br><strong>Phone:</strong> +91-8657944323</p><p>When contacting us about an existing order, please include your order number so that we can assist you efficiently.</p></div>
        </details>
      </div>

    </div>

    <div class="faq__cta">
      <div>
        <p class="faq__cta-eyebrow">Still have a question?</p>
        <h2 class="faq__cta-title">Talk to our <em>customer care</em></h2>
        <p class="faq__cta-text">Our team replies to every enquiry — share your order number and we'll take it from there.</p>
      </div>
      <div class="faq__cta-actions">
        <a class="btn" href="mailto:customercare@sarom.info">Email us</a>
        <a class="btn btn--outline" href="{{ routes.root_url }}pages/contact">Contact page</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var input = document.querySelector('[data-faq-search]');
    if (!input) return;
    var groups = Array.prototype.slice.call(document.querySelectorAll('.faq__group'));
    var empty = document.querySelector('[data-faq-empty]');

    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var anyVisible = false;

      groups.forEach(function (group) {
        var items = Array.prototype.slice.call(group.querySelectorAll('.faq__item'));
        var groupHasMatch = false;

        items.forEach(function (item) {
          var match = !q || item.textContent.toLowerCase().indexOf(q) !== -1;
          item.hidden = !match;
          /* Open matches while searching so the answer is visible without a
             second click, and collapse again once the query is cleared. */
          if (q && match) item.setAttribute('open', '');
          else if (!q) item.removeAttribute('open');
          if (match) groupHasMatch = true;
        });

        group.hidden = !groupHasMatch;
        if (groupHasMatch) anyVisible = true;
      });

      if (empty) empty.hidden = anyVisible;
    });
  })();
</script>

<style>
  .faq { padding: 70px 0 100px; }
  .faq__head { text-align: center; max-width: 640px; margin: 0 auto 56px; }
  .faq__head .eyebrow { margin-bottom: 10px; }
  .faq__sub { color: var(--muted); font-size: 15.5px; line-height: 1.7; margin: 16px 0 0; }

  .faq__search { position: relative; margin: 30px auto 0; max-width: 420px; }
  .faq__search svg { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--taupe); pointer-events: none; }
  .faq__search input {
    width: 100%;
    padding: 13px 18px 13px 44px;
    font-size: 14.5px;
    color: var(--brown);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .faq__search input::placeholder { color: var(--taupe); }
  .faq__search input:focus { outline: none; border-color: var(--taupe); }
  .faq__search input::-webkit-search-cancel-button { cursor: pointer; }
  .faq__empty { color: var(--muted); font-size: 14.5px; margin: 22px 0 0; }
  .faq__empty a { color: var(--brown); text-decoration: underline; text-underline-offset: 3px; }
  .faq__group[hidden], .faq__item[hidden] { display: none; }

  .faq__cta {
    max-width: 780px;
    margin: 64px auto 0;
    background: var(--cream-2);
    border-radius: var(--radius-lg);
    padding: 40px 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .faq__cta-eyebrow { font-family: var(--font-ui); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--taupe); margin: 0 0 12px; }
  .faq__cta-title { font-family: var(--font-serif); font-weight: 400; font-size: clamp(23px, 2.8vw, 30px); color: var(--brown); margin: 0; }
  .faq__cta-title em { font-style: italic; }
  .faq__cta-text { color: var(--muted); font-size: 14.5px; line-height: 1.7; margin: 12px 0 0; max-width: 44ch; }
  .faq__cta-actions { display: flex; flex-wrap: wrap; gap: 12px; flex: none; }
  .faq__groups { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: 44px; }
  .faq__group-title { font-family: var(--font-ui); font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--taupe); margin: 0 0 4px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item[open] .faq__ico { transform: rotate(45deg); }
  .faq__q { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 0; font-family: var(--font-serif); font-size: 17px; color: var(--brown); }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__ico { flex-shrink: 0; font-size: 20px; line-height: 1; color: var(--taupe); font-weight: 300; transition: transform .2s ease; }
  .faq__a { padding: 0 0 22px; color: var(--brown-2); font-size: 14.5px; line-height: 1.7; max-width: 66ch; }
  .faq__a p { margin: 0 0 12px; }
  .faq__a p:last-child { margin-bottom: 0; }
  .faq__a ul { margin: 0 0 12px; padding-left: 20px; }
  .faq__a a { color: var(--brown); text-decoration: underline; }

  @media (max-width: 600px) {
    .faq { padding: 48px 0 64px; }
    .faq__q { font-size: 15.5px; }
    .faq__cta { padding: 28px 24px; margin-top: 48px; }
    .faq__cta-actions { width: 100%; }
    .faq__cta-actions .btn { flex: 1 1 100%; }
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "settings": []
}
{% endschema %}
