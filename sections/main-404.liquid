<section class="section error-404" style="padding-top:{{ section.settings.section_padding_top }}px;padding-bottom:{{ section.settings.section_padding_bottom }}px">
  <div class="container error-404__inner">
    <p class="eyebrow" style="font-size:{{ section.settings.eyebrow_size }}px;color:{{ section.settings.eyebrow_color }};font-family:var(--font-{{ section.settings.eyebrow_font }})">{{ section.settings.eyebrow }}</p>
    <h1 class="error-404__title" style="font-size:clamp({{ section.settings.heading_size | times: 0.65 | round }}px, 4vw, {{ section.settings.heading_size }}px);margin-bottom:{{ section.settings.header_spacing }}px;color:{{ section.settings.heading_color }};font-family:var(--font-{{ section.settings.heading_font }})">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="error-404__text" style="font-size:{{ section.settings.text_size }}px;color:{{ section.settings.text_color }};font-family:var(--font-{{ section.settings.text_font }})">{{ section.settings.text }}</div>{%- endif -%}
    <a class="btn" href="{{ routes.root_url }}">{{ section.settings.button_label }}</a>
  </div>
</section>

<style>
  .error-404__inner { text-align: center; padding: 60px 0; max-width: 560px; }
  .error-404__title { font-size: clamp(30px, 4vw, 46px); margin: 0 0 14px; }
  .error-404__text { color: var(--muted); margin: 0 0 30px; }
</style>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "inline_richtext", "id": "eyebrow", "label": "Eyebrow text", "default": "404" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "richtext", "id": "text", "label": "Subheading", "default": "<p>The page you're looking for doesn't exist or has moved.</p>" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "text_size", "label": "Subheading size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "header_spacing", "label": "Header spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#8c8275" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#5a5148" },
    { "type": "color", "id": "text_color", "label": "Subheading color", "default": "#8c8275" },
    { "type": "select", "id": "eyebrow_font", "label": "Eyebrow font", "default": "ui", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "select", "id": "text_font", "label": "Subheading font", "default": "sans", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "section_padding_top", "label": "Padding top", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "section_padding_bottom", "label": "Padding bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Continue shopping" }
  ]
}
{% endschema %}
