{%- comment -%} You may also like — Beds & More by Sarom {%- endcomment -%}
{%- liquid
  assign limit = section.settings.products_limit
  assign source = null
  if section.settings.collection != blank
    assign source = section.settings.collection.products
  elsif recommendations.performed and recommendations.products_count > 0
    assign source = recommendations.products
  elsif product.collections.size > 0
    assign source = product.collections.first.products
  endif
-%}

<section class="section rel" data-section-id="{{ section.id }}" style="padding-top:{{ section.settings.section_padding_top }}px;padding-bottom:{{ section.settings.section_padding_bottom }}px">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <p class="eyebrow rel__eyebrow" style="font-size:{{ section.settings.heading_size }}px;color:{{ section.settings.heading_color }};font-family:var(--font-{{ section.settings.heading_font }})">{{ section.settings.heading }}</p>
    {%- endif -%}

    <div class="rel__wrap" style="margin-top:{{ section.settings.header_spacing }}px">
      <button class="round-btn rel__nav rel__nav--prev" type="button" aria-label="Previous" data-rel-prev>
        {% render 'icon', icon: 'arrow-left' %}
      </button>

      <div class="rel__track" data-rel-track>
        {%- if source and source.size > 0 -%}
          {%- assign shown = 0 -%}
          {%- for item in source -%}
            {%- if item.id != product.id and shown < limit -%}
              <div class="rel__item">{% render 'product-card', product: item %}</div>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if shown == 0 -%}
            {%- for i in (1..3) -%}
              <div class="rel__item rel__item--ph">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endfor -%}
          {%- endif -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="rel__item rel__item--ph">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button class="round-btn rel__nav rel__nav--next" type="button" aria-label="Next" data-rel-next>
        {% render 'icon', icon: 'arrow-right' %}
      </button>
    </div>
  </div>
</section>

{%- style -%}
  .rel .container { max-width: var(--container); margin: auto; }
  .rel__eyebrow { text-align: center; font-size: 13px; letter-spacing: 5px; text-transform: uppercase; color: #8d7966; font-weight: 500; margin-bottom: 0; }

  .rel__wrap { position: relative; margin-top: 40px; }

  .rel__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 76px) / 3); gap: 38px; align-items: start; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; }
  .rel__track::-webkit-scrollbar { display: none; }
  .rel__item { min-width: 0; display: flex; }
  .rel__item--ph { border-radius: var(--radius); overflow: hidden; background: var(--cream-2); aspect-ratio: 3/4; }
  .rel__item--ph svg { width: 100%; height: 100%; object-fit: cover; }

  /* PRODUCT CARD (matches homepage Bestsellers styling) */
  .rel .product-card { width: 100%; height: 100%; background: transparent; border: none; padding: 0; display: flex; flex-direction: column; }
  .rel .product-card__media { position: relative; overflow: hidden; border-radius: 18px; aspect-ratio: 3/4; background: #f5f3ef; padding: 0; display: block; }
  .rel .product-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .rel .product-card:hover .product-card__media img { transform: scale(1.03); }
  .rel .product-card__body { padding: 16px 0 0; display: flex; flex-direction: column; flex: 1; }
  .rel .product-card__title { font-size: 21px; font-weight: 500; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 6px; line-height: 1.3; }
  .rel .product-card__meta { font-size: 12px; letter-spacing: .3px; color: #8c8c8c; line-height: 1.5; margin: 0; }
  .rel .product-card__meta:first-of-type { color: #5f5246; }
  .rel .product-card__price { display: block; font-size: 19px; font-weight: 500; margin: 10px 0 16px; margin-top: auto; }
  .rel .product-card__add { width: 100%; height: 52px; border: 1px solid #b39b7d; background: transparent; text-transform: uppercase; letter-spacing: 3px; font-size: 13px; transition: .3s; }
  .rel .product-card__add:hover { background: #5f5246; color: #fff; border-color: #5f5246; }
  .rel .product-card__add[disabled] { opacity: .6; cursor: default; }
  .rel .product-card__wish { position: absolute; top: 14px; right: 14px; background: none; border: none; padding: 0; color: #5f5246; }
  .rel .product-card__wish svg { width: 18px; height: 18px; }

  /* ARROWS */
  .rel__nav { width: 48px; height: 48px; border: 1px solid #8d7966; border-radius: 999px; background: #fff; display: flex; align-items: center; justify-content: center; position: absolute; top: 0; transition: .3s; z-index: 10; }
  .rel__nav svg { width: 16px; height: 16px; }
  .rel__nav:hover { background: #f2ece2; }
  .rel__nav--prev { left: -60px; }
  .rel__nav--next { right: -60px; }

  @media (max-width: 990px) {
    .rel__track { grid-auto-columns: calc((100% - 30px) / 2); }
    .rel__nav { display: none; }
  }
  @media (max-width: 600px) {
    .rel__track { grid-auto-columns: 82%; }
  }
{%- endstyle -%}

<script>
(function(){
  var root = document.querySelector('#shopify-section-{{ section.id }} .rel');
  if (!root || root.dataset.relInit) return;
  root.dataset.relInit = '1';
  var track = root.querySelector('[data-rel-track]');
  var prev = root.querySelector('[data-rel-prev]');
  var next = root.querySelector('[data-rel-next]');
  function step(){ return track.clientWidth / 3 + 38; }
  prev.addEventListener('click', function(){ track.scrollBy({left:-step(),behavior:'smooth'}); });
  next.addEventListener('click', function(){ track.scrollBy({left:step(),behavior:'smooth'}); });

  function alignArrows(){
    var media = root.querySelector('.product-card__media');
    if (!media) return;
    var top = media.offsetHeight / 2 - 24;
    prev.style.top = top + 'px';
    next.style.top = top + 'px';
  }
  alignArrows();
  window.addEventListener('resize', alignArrows);
})();
</script>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "header_spacing", "label": "Header spacing", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#8d7966" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "ui", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "section_padding_top", "label": "Padding top", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "section_padding_bottom", "label": "Padding bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use recommendations or the product's own collection." },
    { "type": "range", "id": "products_limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [
    { "name": "Related products" }
  ]
}
{% endschema %}
