{%- comment -%}
  Fully dynamic mega menu — no hardcoded collections/products.
  Data source: collection metafields only.
    - top-level collection:  metafields.custom.sub_collections (list of category collections, e.g. Bedsheets)
    - each category:         metafields.custom.sub_collections (list of its own sub-collections, e.g. Digital Prints)
  Structure: left = category tabs (top-level's sub_collections), right = the
  active category's own sub_collections as a circle grid. A category with no
  sub_collections of its own falls back to a featured-products grid of its
  own products instead of an empty panel.
  params:
    collection  — the top-level Collection (from the menu link's linked resource)
    label       — nav link label (string)
    url         — nav link href (string)
{%- endcomment -%}
{%- assign categories = collection.metafields.custom.sub_collections.value -%}
{%- if categories == blank or categories.size == 0 -%}
  <a href="{{ url }}" class="site-nav__link">{{ label }}</a>
{%- else -%}
  <div class="site-nav__item mega-menu" data-mega-menu>
    <a href="{{ url }}"
       class="site-nav__link mega-menu__trigger"
       data-mega-trigger
       aria-haspopup="true"
       aria-expanded="false">{{ label }}</a>

    <div class="mega-menu__panel" data-mega-panel role="menu" aria-label="{{ label }}">
      <div class="mega-menu__inner">

        <ul class="mega-menu__list mega-menu__list--categories" data-mega-categories role="tablist">
          {%- for cat in categories -%}
            <li role="presentation">
              <a href="{{ cat.url }}"
                 class="mega-menu__list-link{% if forloop.first %} is-active{% endif %}"
                 data-mega-cat-link
                 data-panel="cat-{{ forloop.index0 }}"
                 role="tab"
                 aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                <span class="mega-menu__cat-thumb">
                  {%- if cat.image -%}
                    <img src="{{ cat.image | image_url: width: 72 }}" alt="" width="36" height="36" loading="lazy">
                  {%- elsif cat.featured_image -%}
                    <img src="{{ cat.featured_image | image_url: width: 72 }}" alt="" width="36" height="36" loading="lazy">
                  {%- endif -%}
                </span>
                <span class="mega-menu__cat-label">{{ cat.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <div class="mega-menu__content" data-mega-content>
          {%- for cat in categories -%}
            <div class="mega-menu__view{% if forloop.first %} is-active{% endif %}" data-mega-view="cat-{{ forloop.index0 }}">
              {%- assign cat_subs = cat.metafields.custom.sub_collections.value -%}
              {%- if cat_subs != blank and cat_subs.size > 0 -%}
                {%- render 'mega-menu-subcollections', sub_collections: cat_subs -%}
              {%- else -%}
                {%- render 'mega-menu-featured-products', collection: cat -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>
{%- endif -%}
