{%- comment -%}
  Fully dynamic mega menu — no hardcoded collections/products.
  Data source: collection metafields only.
    - parent collection: metafields.custom.sub_collections (list of collections)
    - each sub-collection:  metafields.custom.featured_products (list of products)
  params:
    collection  — the parent Collection (from the menu link's linked resource)
    label       — nav link label (string)
    url         — nav link href (string)
    all_links   — the native menu's sibling links, used to list sibling
                  mega-menu nav items in the sidebar
{%- endcomment -%}
{%- assign sub_collections = collection.metafields.custom.sub_collections.value -%}
{%- if sub_collections == blank or sub_collections.size == 0 -%}
  <a href="{{ url }}" class="site-nav__link">{{ label }}</a>
{%- else -%}
  <div class="site-nav__item mega-menu" data-mega-menu>
    <a href="{{ url }}"
       class="site-nav__link mega-menu__trigger"
       data-mega-trigger
       aria-haspopup="true"
       aria-expanded="false">{{ label }}</a>

    <div class="mega-menu__panel" data-mega-panel role="menu" aria-label="{{ label }}">
      <div class="mega-menu__inner">

        <div class="mega-menu__sidebar" data-mega-sidebar>
          {%- render 'mega-menu-parent', all_links: all_links, current_collection: collection -%}

          <ul class="mega-menu__list mega-menu__list--sub" data-mega-sublist hidden>
            {%- for sub in sub_collections -%}
              <li>
                <a href="{{ sub.url }}"
                   class="mega-menu__list-link{% if forloop.first %} is-active{% endif %}"
                   data-mega-sub-link
                   data-panel="sub-{{ forloop.index0 }}">{{ sub.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="mega-menu__content" data-mega-content>
          <div class="mega-menu__view is-active" data-mega-view="grid">
            {%- render 'mega-menu-subcollections', sub_collections: sub_collections -%}
          </div>
          {%- for sub in sub_collections -%}
            <div class="mega-menu__view" data-mega-view="sub-{{ forloop.index0 }}">
              {%- render 'mega-menu-featured-products', collection: sub -%}
            </div>
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>

  {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'mega-menu.js' | asset_url }}" defer></script>
{%- endif -%}
