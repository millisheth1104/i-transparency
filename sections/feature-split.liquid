<section class="section feature-split" style="padding-top:{{ section.settings.section_padding_top }}px;padding-bottom:{{ section.settings.section_padding_bottom }}px">
  <div class="container feature-split__inner {% if section.settings.image_right %}feature-split--reverse{% endif %}">
    <div class="feature-split__media" style="border-radius:{{ section.settings.image_radius }}px;border:{{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};margin:{{ section.settings.image_margin }}px">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" width="1200" height="1400" loading="lazy">
      {%- else -%}
        {{ 'detailed-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="feature-split__body">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="font-size:{{ section.settings.eyebrow_size }}px;margin-bottom:{{ section.settings.header_spacing }}px;color:{{ section.settings.eyebrow_color }};font-family:var(--font-{{ section.settings.eyebrow_font }})">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="feature-split__heading" style="font-size:clamp({{ section.settings.heading_size | times: 0.6 | round }}px, 4.5vw, {{ section.settings.heading_size }}px);color:{{ section.settings.heading_color }};font-family:var(--font-{{ section.settings.heading_font }})">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<div class="feature-split__intro">{{ section.settings.intro }}</div>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="feature-split__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--outline feature-split__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .feature-split__inner { display: grid; grid-template-columns: 480px 1fr; gap: 70px; align-items: stretch; width: 962px; max-width: 100%; height: 540px; margin: 0 auto; padding: 0; }
  .feature-split--reverse .feature-split__media { order: 2; }
  .feature-split__media { border-radius: var(--radius); overflow: hidden; width: 100%; height: 100%; }
  .feature-split__media img, .feature-split__media svg { width: 100%; height: 100%; object-fit: cover; }
  .feature-split__body { display: flex; flex-direction: column; justify-content: center; }
  .feature-split__heading { font-size: clamp(34px, 4.5vw, 56px); }
  .feature-split__heading em { font-style: italic; }
  .feature-split__intro { font-family: var(--font-serif); font-style: italic; font-size: 20px; color: var(--taupe-dark); margin: 22px 0; }
  .feature-split__intro strong { font-weight: 500; color: var(--brown); }
  .feature-split__text { color: var(--brown-2); font-size: 16px; line-height: 1.8; max-width: 46ch; }
  .feature-split__btn { margin-top: 30px; }
  @media (max-width: 860px){ .feature-split__inner { grid-template-columns: 1fr; gap: 34px; height: auto; } .feature-split__media { aspect-ratio: 480/540; height: auto; } .feature-split--reverse .feature-split__media { order: 0; } }
</style>

{% schema %}
{
  "name": "Feature split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_right", "label": "Image on right", "default": false },
    { "type": "header", "content": "Section header" },
    { "type": "inline_richtext", "id": "eyebrow", "label": "Eyebrow text", "default": "Breathable build · Zero bleed" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<em>Woven,</em> not knitted." },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 30, "max": 70, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "header_spacing", "label": "Header spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#8c8275" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#5a5148" },
    { "type": "select", "id": "eyebrow_font", "label": "Eyebrow font", "default": "ui", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "section_padding_top", "label": "Padding top", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "section_padding_bottom", "label": "Padding bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "header", "content": "Image style" },
    { "type": "range", "id": "image_radius", "label": "Image border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "image_border_width", "label": "Image border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "image_border_color", "label": "Image border color", "default": "#5a5148" },
    { "type": "range", "id": "image_margin", "label": "Image margin", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Body copy" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Ordinary premium bedding is knitted: crisp, flat, formal. <strong>Ours is woven.</strong></p>" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Woven gives cotton a different life — a soft, slightly elastic, three-dimensional hand that breathes in summer and holds warmth in winter. It drapes instead of lying stiff, and softens further with every wash rather than wearing thin. It is, simply, the most touchable bed you will own.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Feature split" }]
}
{% endschema %}
