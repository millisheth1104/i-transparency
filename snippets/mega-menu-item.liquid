{%- comment -%}
  Single mega-menu subcategory row: circular thumbnail + title, linked to the
  child collection. params: sub (a linklist link object)
{%- endcomment -%}
{%- assign sub_image = sub.object.image | default: sub.object.featured_image -%}
<a href="{{ sub.url }}" class="mega-menu__item" role="menuitem">
  <span class="mega-menu__thumb">
    {%- if sub_image != blank -%}
      <img src="{{ sub_image | image_url: width: 80 }}" alt="{{ sub.title | escape }}" width="40" height="40" loading="lazy">
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag }}
    {%- endif -%}
  </span>
  <span class="mega-menu__label">{{ sub.title }}</span>
</a>
