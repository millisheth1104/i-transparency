<section class="section category-showcase" style="padding-top:{{ section.settings.section_padding_top }}px;padding-bottom:{{ section.settings.section_padding_bottom }}px">
  <div class="container">
    <h2 class="section-heading" style="font-size:clamp({{ section.settings.heading_size | times: 0.65 | round }}px, 4vw, {{ section.settings.heading_size }}px);color:{{ section.settings.heading_color }};font-family:var(--font-{{ section.settings.heading_font }})">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<div class="section-sub" style="font-size:{{ section.settings.subheading_size }}px;color:{{ section.settings.subheading_color }};font-family:var(--font-{{ section.settings.subheading_font }})">{{ section.settings.subtext }}</div>{%- endif -%}

    <div class="ccs-stage" data-ccs style="margin-top:{{ section.settings.header_spacing }}px">
      {%- for block in section.blocks -%}
        <div class="ccs-card" data-ccs-card style="border-radius:{{ block.settings.image_radius }}px" {{ block.shopify_attributes }}>
          <button class="ccs-card__hit" data-ccs-select aria-label="Show {{ block.settings.title | escape }}"></button>
          <div class="ccs-card__clip" style="border-radius:{{ block.settings.image_radius }}px;border:{{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }}">
            <div class="ccs-card__media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" width="1200" height="900" loading="lazy">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
          </div>
          <span class="ccs-card__num">/{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="ccs-card__content">
            <a href="{{ block.settings.link }}" class="ccs-card__title" data-ccs-stop>{{ block.settings.title }}</a>
            <a class="btn ccs-card__view" href="{{ section.settings.button_link }}" data-ccs-stop>{{ section.settings.button_label }}</a>
            <button class="round-btn ccs-card__next" data-ccs-next data-ccs-stop aria-label="Next category">{% render 'icon', icon: 'arrow-right' %}</button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  /* ~1190x540 reference (2.2:1 stage) with a 77%-wide, 100%-tall active
     card working out to ~1.7:1 — matches the reference card exactly.
     aspect-ratio keeps this fully responsive with no fixed px. */
  .ccs-stage { position: relative; width: 100%; aspect-ratio: 2.2 / 1; margin: 40px 0; overflow: hidden; border-radius: var(--radius); }
  .ccs-card {
    position: absolute; left: 0; top: 0;
    width: 77%; height: 100%;
    background: var(--cream-2);
    transform-origin: left top;
    transition: transform 1050ms cubic-bezier(.22,1,.36,1),
                opacity 1050ms cubic-bezier(.22,1,.36,1);
    will-change: transform, opacity;
  }
  /* .ccs-card ALSO gets the same border-radius as .ccs-card__clip (inline,
     see markup) so its own background paints with rounded corners too --
     without that, .ccs-card__clip's rounded cutout reveals .ccs-card's
     sharp square corner peeking out just behind/around the rounded photo.
     This is safe (no Safari clipping bug) because .ccs-card has no
     overflow:hidden -- border-radius alone only affects how a box paints
     its own background/border, not content clipping, so it doesn't hit
     the overflow+radius+transform bug described below. */
  /* overflow:hidden (the actual content clip) lives on this separate,
     untransformed child instead -- because Safari/WebKit has a
     long-standing bug where overflow:hidden + border-radius fails to
     clip an element that also has a CSS transform applied (which
     .ccs-card gets from the JS stack animation), silently rendering it
     with square corners. */
  .ccs-card__clip { position: absolute; inset: 0; overflow: hidden; }
  .ccs-card__clip::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,16,12,0) 45%, rgba(20,16,12,.4) 100%); pointer-events: none; }
  .ccs-card__hit { position: absolute; inset: 0; z-index: 1; background: none; border: none; padding: 0; cursor: pointer; }
  .ccs-card[data-active="true"] .ccs-card__hit { cursor: default; }
  .ccs-card__media { position: absolute; inset: 0; }
  .ccs-card__media img, .ccs-card__media svg { width: 100%; height: 100%; object-fit: cover; }
  .ccs-card__num { position: absolute; top: 26px; left: 30px; color: var(--brown-2); font-size: 13px; letter-spacing: .08em; z-index: 2; }
  .ccs-card__content { position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; transition: opacity .4s ease; }
  .ccs-card[data-active="true"] .ccs-card__content { opacity: 1; pointer-events: auto; }
  .ccs-card[data-active="true"] .ccs-card__content a,
  .ccs-card[data-active="true"] .ccs-card__content button { pointer-events: auto; }
  .ccs-card__title { position: absolute; top: 44px; left: 30px; color: var(--brown); font-family: var(--font-serif); font-size: 34px; }
  .ccs-card__view { position: absolute; left: 30px; bottom: 30px; }
  .ccs-card__next { position: absolute; right: 30px; bottom: 30px; background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.6); color: #fff; }
  .ccs-card__next:hover { background: #fff; color: var(--brown); }

  @media (max-width: 860px) {
    .ccs-stage { aspect-ratio: 1.4 / 1; }
    .ccs-card__title { font-size: 24px; }
  }
</style>

<script>
  document.querySelectorAll('[data-ccs]').forEach(function (stage) {
    if (stage.dataset.ccsInit) return;
    stage.dataset.ccsInit = '1';

    var cards = Array.prototype.slice.call(stage.querySelectorAll('[data-ccs-card]'));
    if (!cards.length) return;

    var order = cards.map(function (_, i) { return i; });
    var timer = null;

    /* xFrac/yFrac are fractions of the stage's own rendered width, so the
       stack always fills the stage edge-to-edge and stays centered at any
       screen size or stage width. */
    /* With transform-origin: left top, a card's rendered bottom edge sits at
       y + height*s. To keep it inside the stage (so overflow:hidden doesn't
       slice off the rounded bottom corner), y must stay under height*(1-s)
       for its scale — these values leave a safe margin under that cap. */
    var POS = [
      { x: 0,     y: 0,    s: 1,   o: 1,   z: 6 },
      { x: .1085, y: .045, s: .95, o: 1,   z: 5 },
      { x: .207,  y: .085, s: .90, o: .97, z: 4 },
      { x: .296,  y: .13,  s: .85, o: .93, z: 3 },
      { x: .374,  y: .18,  s: .80, o: .88, z: 2 },
      { x: .442,  y: .23,  s: .75, o: .82, z: 1 }
    ];
    var HIDDEN = { x: .5, y: .26, s: .72, o: 0, z: 0 };

    function apply() {
      var stageWidth = stage.clientWidth;
      var stageHeight = stage.clientHeight;
      order.forEach(function (cardIndex, pos) {
        var card = cards[cardIndex];
        var p = POS[pos] || HIDDEN;
        var x = p.x * stageWidth;
        var y = p.y * stageHeight;
        card.style.transform = 'translate(' + x + 'px,' + y + 'px) scale(' + p.s + ')';
        card.style.opacity = p.o;
        card.style.zIndex = p.z;
        card.style.pointerEvents = p.o === 0 ? 'none' : 'auto';
        card.dataset.active = pos === 0 ? 'true' : 'false';
      });
    }

    function rotate(steps) {
      steps = ((steps % order.length) + order.length) % order.length;
      for (var i = 0; i < steps; i++) order.push(order.shift());
      apply();
      restartAutoplay();
    }

    function restartAutoplay() {
      if (timer) clearInterval(timer);
      timer = setInterval(function () { rotate(1); }, 10000);
    }

    cards.forEach(function (card) {
      card.querySelectorAll('[data-ccs-stop]').forEach(function (el) {
        el.addEventListener('click', function (e) { e.stopPropagation(); });
      });
      var hit = card.querySelector('[data-ccs-select]');
      hit.addEventListener('click', function () {
        var pos = order.indexOf(cards.indexOf(card));
        if (pos > 0) rotate(pos);
      });
      var next = card.querySelector('[data-ccs-next]');
      if (next) next.addEventListener('click', function (e) { e.stopPropagation(); rotate(1); });
    });

    stage.addEventListener('mouseenter', function () { if (timer) clearInterval(timer); });
    stage.addEventListener('mouseleave', restartAutoplay);

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(apply, 100);
    });

    /* Mobile swipe: swipe left = next, swipe right = previous. */
    var touchStartX = 0;
    stage.addEventListener('touchstart', function (e) {
      touchStartX = e.touches[0].clientX;
      if (timer) clearInterval(timer);
    }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) rotate(dx < 0 ? 1 : -1);
      else restartAutoplay();
    }, { passive: true });

    apply();
    restartAutoplay();
  });
</script>

{% schema %}
{
  "name": "Category showcase",
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop by <em>category</em>" },
    { "type": "richtext", "id": "subtext", "label": "Subheading", "default": "<p>One knitted-cotton family, three ways to layer your bed — across nine shades drawn from the earth.</p>" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "header_spacing", "label": "Header spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#5a5148" },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#8c8275" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "select", "id": "subheading_font", "label": "Subheading font", "default": "sans", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "section_padding_top", "label": "Padding top", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "section_padding_bottom", "label": "Padding bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "header", "content": "Categories" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Image style" },
        { "type": "range", "id": "image_radius", "label": "Image border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
        { "type": "range", "id": "image_border_width", "label": "Image border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 0 },
        { "type": "color", "id": "image_border_color", "label": "Image border color", "default": "#5a5148" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category showcase",
      "blocks": [
        { "type": "category", "settings": { "title": "Bed covers" } },
        { "type": "category", "settings": { "title": "Comforters" } },
        { "type": "category", "settings": { "title": "Throws" } },
        { "type": "category", "settings": { "title": "Pillow covers" } },
        { "type": "category", "settings": { "title": "Cushions" } }
      ]
    }
  ]
}
{% endschema %}
