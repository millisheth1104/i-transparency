{%- comment -%}
  params: value (a colour option value, e.g. "Stone")
  Outputs a bare hex string. Kept in sync with the sampled colour map in
  sections/main-product.liquid -- see that file for the sampling method and
  the notes on names that don't match their actual hue (Feather Grey, Mocha,
  Tea, etc.). Duplicated here rather than shared via render because the
  product-page map is large and already battle-tested; copy stays frozen
  unless a colour is added to the catalog.
{%- endcomment -%}
{%- assign v = value | downcase | strip -%}
{%- case v -%}
  {%- when 'bright white' -%}{%- assign hex = '#e3e1e3' -%}
  {%- when 'tofu' -%}{%- assign hex = '#e8e2d6' -%}
  {%- when 'peyote' -%}{%- assign hex = '#c5beab' -%}
  {%- when 'plaza taupe' -%}{%- assign hex = '#b9ae93' -%}
  {%- when 'desert taupe' -%}{%- assign hex = '#6f675a' -%}
  {%- when 'drizzle' -%}{%- assign hex = '#a7a5a2' -%}
  {%- when 'dove' -%}{%- assign hex = '#aca497' -%}
  {%- when 'moonstruck' -%}{%- assign hex = '#bab7a8' -%}
  {%- when 'pumice stone','lt. grey mel','lt grey mel' -%}{%- assign hex = '#ada698' -%}
  {%- when 'off white' -%}{%- assign hex = '#e6e0d3' -%}
  {%- when 'silver lining' -%}{%- assign hex = '#c5b8a5' -%}
  {%- when 'light grey' -%}{%- assign hex = '#bbbab6' -%}
  {%- when 'stone grey' -%}{%- assign hex = '#9a9383' -%}
  {%- when 'stone' -%}{%- assign hex = '#b4aa9f' -%}
  {%- when 'green lint' -%}{%- assign hex = '#bebea8' -%}
  {%- when 'feather grey' -%}{%- assign hex = '#a8987e' -%}
  {%- when 'beige','lt. beige mel','lt beige mel' -%}{%- assign hex = '#b09f83' -%}
  {%- when 'nude','nude/blush' -%}{%- assign hex = '#c5ae9f' -%}
  {%- when 'turtle dove' -%}{%- assign hex = '#b0a39d' -%}
  {%- when 'cream' -%}{%- assign hex = '#c5bba0' -%}
  {%- when 'taupe' -%}{%- assign hex = '#aea78c' -%}
  {%- when 'blush' -%}{%- assign hex = '#c5ae9f' -%}
  {%- when 'natural' -%}{%- assign hex = '#d3c7b2' -%}
  {%- when 'birch' -%}{%- assign hex = '#beab9a' -%}
  {%- when 'moonrock' -%}{%- assign hex = '#9d9383' -%}
  {%- when 'ivory' -%}{%- assign hex = '#bbb2aa' -%}
  {%- when 'linen' -%}{%- assign hex = '#b0a494' -%}
  {%- when 'mocha' -%}{%- assign hex = '#958a84' -%}
  {%- when 'sage' -%}{%- assign hex = '#b6bfb4' -%}
  {%- when 'oatmeal' -%}{%- assign hex = '#ac978c' -%}
  {%- when 'beige melange','beige mel' -%}{%- assign hex = '#ccbaaf' -%}
  {%- when 'green melange','green mel' -%}{%- assign hex = '#a6ad93' -%}
  {%- when 'popcorn' -%}{%- assign hex = '#eedbc9' -%}
  {%- when 'oatmeal popcorn' -%}{%- assign hex = '#9e8b81' -%}
  {%- when 'beige melange popcorn','beige mel popcorn' -%}{%- assign hex = '#c3b1a6' -%}
  {%- when 'tea' -%}{%- assign hex = '#768087' -%}
  {%- when 'lt. blue daisy','lt blue daisy','blue daisy' -%}{%- assign hex = '#5e656f' -%}
  {%- comment -%} Bliss (PC dyed jacquard) line, 4 designs sharing one 6-colour
    palette -- sampled as the average of all 4 designs' own colour photos so
    one hex serves the whole line consistently, same principle as Oscar
    being the reference source for its shared colour names. {%- endcomment -%}
  {%- when 'chalk' -%}{%- assign hex = '#e1e2e5' -%}
  {%- when 'clay' -%}{%- assign hex = '#8e836f' -%}
  {%- when 'smoke' -%}{%- assign hex = '#837a6e' -%}
  {%- when 'grey','gray' -%}{%- assign hex = '#aea9a5' -%}
  {%- when 'green' -%}{%- assign hex = '#a0a49e' -%}
  {%- when 'midlife brown','mahogany','brown' -%}{%- assign hex = '#7a5c46' -%}
  {%- when 'sand' -%}{%- assign hex = '#ddd0b9' -%}
  {%- else -%}{%- assign hex = '#ddd0b9' -%}
{%- endcase -%}{{ hex }}
