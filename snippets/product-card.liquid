{%- comment -%} params: product, show_add (default true) {%- endcomment -%}
{%- assign p = product -%}
{%- comment -%}
  custom.size is set to the bare number 1 on every product in the catalog
  (checked all 95 via the storefront), so this line rendered a meaningless
  "1" under the product type on every card, everywhere the snippet is used.

  Rather than deleting the line, anything that is only a number is rejected:
  a size needs a word or a unit to mean anything on a card. That drops the
  junk value, lets the real variant Size option below be used instead, and
  still shows a genuine text value ("King", "90 x 100 in") if the metafield
  is ever filled in properly.

  `plus: 0` is the Liquid idiom for "is this numeric" -- a non-numeric string
  yields 0 -- so only values that survive as a number, or are literally "0",
  are discarded. `append: ''` first, because the metafield comes back as an
  integer and the string filters need a string.
{%- endcomment -%}
{%- assign size_value = p.metafields.custom.size | append: '' | strip -%}
{%- assign size_as_number = size_value | plus: 0 -%}
{%- if size_as_number != 0 or size_value == '0' -%}
  {%- assign size_value = '' -%}
{%- endif -%}
{%- if size_value == blank -%}
  {%- for option in p.options_with_values -%}
    {%- if option.name == 'Size' -%}
      {%- assign size_index = option.position | minus: 1 -%}
      {%- assign size_value = p.selected_or_first_available_variant.options[size_index] -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- comment -%}
  Colour swatches: find the product's colour-like option (same detection
  main-product.liquid uses -- name contains color/colour/shade) and render up
  to max_swatches dots, each linking to the matching variant, with a "+N"
  overflow badge for the rest rather than cramming every colour onto a card.
{%- endcomment -%}
{%- assign color_option = blank -%}
{%- for option in p.options_with_values -%}
  {%- assign opt_name_dc = option.name | downcase -%}
  {%- if opt_name_dc contains 'color' or opt_name_dc contains 'colour' or opt_name_dc contains 'shade' -%}
    {%- assign color_option = option -%}
  {%- endif -%}
{%- endfor -%}
{%- if color_option != blank and color_option.values.size > 1 -%}
  {%- assign color_index = color_option.position | minus: 1 -%}
  {%- assign max_swatches = 6 -%}
{%- else -%}
  {%- comment -%}
    Single-colour products (no Color option, or only one value) still have a
    colour -- the custom.shade metafield already shown as text below. Show
    that same colour as one swatch dot instead of leaving the row blank, so
    cards look consistent across the grid.
  {%- endcomment -%}
  {%- assign fallback_shade = p.metafields.custom.shade | append: '' | strip -%}
  {%- assign fallback_shade_number = fallback_shade | plus: 0 -%}
  {%- if fallback_shade_number != 0 or fallback_shade == '0' -%}
    {%- assign fallback_shade = '' -%}
  {%- endif -%}
{%- endif -%}
<div class="product-card">
  <a href="{{ p.url }}" class="product-card__media"{% if p.images.size > 1 %} data-pc-cycle{% endif %}>
    {%- if p.featured_image -%}
      {%- assign cycle_images = p.images | slice: 0, 5 -%}
      {%- for cycle_image in cycle_images -%}
        <img class="product-card__media-frame{% if forloop.first %} is-active{% endif %}" src="{{ cycle_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" width="600" height="800" loading="lazy">
      {%- endfor -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    <button class="product-card__wish" aria-label="Add to wishlist" type="button" data-wishlist="{{ p.id }}">{% render 'icon', icon: 'heart' %}</button>
  </a>
  <div class="product-card__body">
    <a href="{{ p.url }}">
      <h3 class="product-card__title">{{ p.title }}</h3>
    </a>
    {%- if color_option != blank and color_option.values.size > 1 -%}
      <div class="product-card__swatches">
        {%- for value in color_option.values limit: max_swatches -%}
          {%- capture hex -%}{%- render 'swatch-hex', value: value -%}{%- endcapture -%}
          {%- assign matched_variant = blank -%}
          {%- for variant in p.variants -%}
            {%- if variant.options[color_index] == value -%}
              {%- assign matched_variant = variant -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if matched_variant != blank -%}
            <a href="{{ p.url }}?variant={{ matched_variant.id }}" class="product-card__swatch" title="{{ value | escape }}" style="background:{{ hex | strip }};" aria-label="{{ value | escape }}"></a>
          {%- endif -%}
        {%- endfor -%}
        {%- assign swatch_remaining = color_option.values.size | minus: max_swatches -%}
        {%- if swatch_remaining > 0 -%}
          <span class="product-card__swatch-more">+{{ swatch_remaining }}</span>
        {%- endif -%}
      </div>
    {%- elsif fallback_shade != blank -%}
      {%- capture fallback_hex -%}{%- render 'swatch-hex', value: fallback_shade -%}{%- endcapture -%}
      <div class="product-card__swatches">
        <span class="product-card__swatch" title="{{ fallback_shade | escape }}" style="background:{{ fallback_hex | strip }};" aria-label="{{ fallback_shade | escape }}"></span>
      </div>
    {%- endif -%}
    {%- if p.metafields.custom.shade != blank and p.metafields.custom.shade != 0 and p.metafields.custom.shade != '0' -%}<p class="product-card__meta">{{ p.metafields.custom.shade }}</p>{%- endif -%}
    {%- if p.type != blank and p.type != 0 and p.type != '0' -%}<p class="product-card__meta">{{ p.type }}</p>{%- endif -%}
    {%- if size_value != blank and size_value != 0 and size_value != '0' -%}<p class="product-card__meta">{{ size_value }}</p>{%- endif -%}
    <span class="product-card__price">&#8377;{{ p.price | money_without_currency | remove: '.00' }}</span>
    {%- unless show_add == false -%}
      {%- if p.available -%}
        <product-form>
          {%- form 'product', p, class: 'product-card__form' -%}
            <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
            <button type="submit" class="product-card__add">Add to cart</button>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <button class="product-card__add" disabled>Sold out</button>
      {%- endif -%}
    {%- endunless -%}
  </div>
</div>
