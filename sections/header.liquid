<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="site-header__logo-img" width="300" height="200">
      {%- else -%}
        <img src="{{ 'logo.png.jpeg' | asset_url }}" alt="{{ shop.name }}" class="site-header__logo-img" width="300" height="200">
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Primary">
      {%- assign nav_menu = linklists[section.settings.menu] -%}
      {%- for link in nav_menu.links -%}
        <div>
          {%- comment -%} "Collections" used to be wired to a catch-all
            smart collection purely so the mega-menu dropdown had a
            metafield source to hang off of. Per merchant request, that
            dropdown is removed — "Collections" is now always a plain link
            to Shopify's actual "browse all collections" page, regardless
            of whether its linked resource still carries sub_collections.
            "Shop" (and any other mega-menu-eligible nav item) is
            unaffected. {%- endcomment -%}
          {%- assign sub_collections = link.object.metafields.custom.sub_collections.value -%}
          {%- if link.object.handle == 'collections-menu-root' -%}
            <a href="{{ routes.collections_url }}" class="site-nav__link">{{ link.title }}</a>
          {%- elsif sub_collections != blank and sub_collections.size > 0 -%}
            {%- render 'mega-menu', collection: link.object, label: link.title, url: link.url -%}
          {%- else -%}
            <a href="{{ link.url }}" class="site-nav__link">{{ link.title }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>
    {%- comment -%} Included once here, not per mega-menu instance — the
      snippet gets rendered once per top-level nav item, and a <script>
      tag re-executes every time it appears in the DOM regardless of
      identical src, which was double-binding every click handler and
      immediately toggling the panel back closed. {%- endcomment -%}
    {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'mega-menu.js' | asset_url }}" defer></script>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" aria-label="Search">{% render 'icon', icon: 'search' %}</a>
      <a href="/pages/wishlist" aria-label="Wishlist">{% render 'icon', icon: 'heart' %}</a>
      <a href="{{ routes.cart_url }}" class="site-header__cart" aria-label="Cart">
        {% render 'icon', icon: 'bag' %}
        {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
      <a href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', icon: 'user' %}</a>
      <button class="site-header__burger" aria-label="Menu" data-nav-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--cream); border-bottom: 1px solid rgba(216,204,182,.5); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; padding-top: 18px; padding-bottom: 18px; }
  .site-header__logo-img { height: 58px; width: auto; display: block; }
  .logo-mark { font-family: var(--font-serif); font-size: 26px; line-height: .9; color: var(--brown); display: inline-block; position: relative; }
  .logo-mark em { font-style: italic; }
  .logo-mark small { display: block; font-family: var(--font-ui); font-weight: 300; font-size: 9px; letter-spacing: .25em; text-transform: uppercase; color: var(--taupe); text-align: right; }
  .site-nav { display: flex; gap: 44px; position: absolute; left: 50%; transform: translateX(-50%); }
  .site-nav__link { font-family: var(--font-ui); font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--brown); transition: color .2s; }
  .site-nav__link:hover { color: var(--taupe); }
  .site-header__actions { display: flex; align-items: center; gap: 22px; color: var(--brown); }
  .site-header__cart { position: relative; }
  .cart-count { position: absolute; top: -8px; right: -10px; background: var(--brown); color: #fff; font-size: 10px; min-width: 16px; height: 16px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; padding: 0 4px; }
  .site-header__burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; padding: 4px; }
  .site-header__burger span { width: 22px; height: 1.5px; background: var(--brown); display: block; }

  @media (max-width: 990px) {
    .site-nav { position: fixed; inset: 72px 0 auto 0; flex-direction: column; gap: 0; background: var(--cream); transform: none; padding: 10px 24px 24px; border-bottom: 1px solid var(--line); display: none; }
    .site-nav.is-open { display: flex; }
    .site-nav__link { padding: 14px 0; border-bottom: 1px solid rgba(216,204,182,.4); }
    .site-header__burger { display: flex; }

    /* Icons were only ~20x27px of real tappable area (raw SVG, no padding) --
       well under the ~44px minimum comfortable touch target. Padding + an
       equal negative margin keeps the visible icon spacing/position exactly
       as before while enlarging the actual tap area around each one. */
    .site-header__actions { gap: 6px; }
    .site-header__actions a, .site-header__burger { padding: 11px; margin: -11px; }
    .site-header__cart .cart-count { top: 1px; right: 3px; }
  }
</style>

<script>
  document.querySelector('[data-nav-toggle]')?.addEventListener('click', function () {
    document.querySelector('.site-nav')?.classList.toggle('is-open');
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Managed in Online Store > Navigation. Any top-level item pointing to a collection with a 'Sub collections' metafield automatically becomes a mega menu — no extra setup needed here." }
  ]
}
{% endschema %}
