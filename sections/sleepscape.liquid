<section class="section sleepscape" style="padding-top:{{ section.settings.section_padding_top }}px;padding-bottom:{{ section.settings.section_padding_bottom }}px">
  <div class="sleepscape__inner">
    <h2 class="section-heading" style="font-size:clamp({{ section.settings.heading_size | times: 0.65 | round }}px, 4vw, {{ section.settings.heading_size }}px);color:{{ section.settings.heading_color }};font-family:var(--font-{{ section.settings.heading_font }})">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<div class="section-sub" style="font-size:{{ section.settings.subheading_size }}px;color:{{ section.settings.subheading_color }};font-family:var(--font-{{ section.settings.subheading_font }})">{{ section.settings.subtext }}</div>{%- endif -%}

    <div class="sleepscape__stage" style="margin-top:{{ section.settings.header_spacing }}px;border-radius:{{ section.settings.image_radius }}px;border:{{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }}">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" width="2000" height="1200" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign prod = all_products[block.settings.product] -%}
        <div class="hotspot" data-hotspot style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
          <button class="hotspot__dot" aria-label="View product" data-hotspot-toggle>+</button>
          {%- if prod != empty -%}
            <div class="hotspot__card">
              <div class="hotspot__card-media">
                {%- if prod.featured_image -%}<img src="{{ prod.featured_image | image_url: width: 300 }}" alt="{{ prod.title | escape }}" width="300" height="300">{%- endif -%}
                <button class="product-card__wish" aria-label="Wishlist">{% render 'icon', icon: 'heart' %}</button>
              </div>
              <div class="hotspot__card-body">
                <p class="hotspot__card-title">{{ prod.title }}</p>
                {%- if block.settings.subtitle != blank -%}<p class="product-card__meta">{{ block.settings.subtitle }}</p>{%- endif -%}
                <span class="product-card__price">{{ prod.price | money_without_trailing_zeros }}</span>
                <a class="product-card__add" href="{{ prod.url }}">Add to cart</a>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .sleepscape__inner { width: calc(100% - (var(--gutter) * 2)); max-width: var(--container); margin: 0 auto; }
  /* No overflow:hidden here. It was only ever needed to clip the room photo
     to the rounded corners, but it also clipped the hotspot cards, which are
     absolutely positioned inside this box -- and on a phone the stage is just
     176px tall while a card is 255-297px, so roughly 200px of every card
     (its price and Add to cart button included) was cut off. The radius is
     inherited by the image instead, so the corners still clip and the cards
     are free to hang outside the photo like the popovers they are. */
  .sleepscape__stage { position: relative; margin-top: 36px; border-radius: var(--radius); width: 100%; height: 620px; }
  /* This block sits above the .hotspot__card rules on purpose now: it used to
     also carry `.hotspot__card { width: 130px }` and a smaller card-media,
     but those were dead code -- same specificity as the base rules below and
     declared earlier, so the base 169px always won and the card has only ever
     rendered at its desktop size on phones. Removed rather than moved, since
     169px reads better on a 375px screen than 130px would and shrinking the
     card does nothing for the cropping this section actually had. Anything
     added here that also exists below needs to go after those rules. */
  @media (max-width: 700px){
    .sleepscape__stage { height: auto; aspect-ratio: 1155 / 620; }
  }
  .sleepscape__stage > img, .sleepscape__stage > svg { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .hotspot { position: absolute; transform: translate(-50%, -50%); }
  .hotspot__dot { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.9); border: none; color: var(--brown); font-size: 20px; line-height: 1; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,.15); }
  .hotspot__card { position: absolute; top: 44px; left: 50%; transform: translateX(-50%) translateY(8px); width: 169.07px; background: var(--white); border: 1px solid var(--taupe-dark); border-radius: 0; opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; box-shadow: 0 20px 45px rgba(45,38,32,.18); z-index: 3; }
  .hotspot.is-open .hotspot__card { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }
  @media (hover: hover) {
    .hotspot:hover .hotspot__card, .hotspot:focus-within .hotspot__card { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }
  }
  /* Flipped to sit above its dot when there isn't room below (set from JS).
     Declared after the base rules so it wins on equal specificity, and the
     entrance offset flips sign so the card still slides in away from the dot. */
  .hotspot__card--above { top: auto; bottom: 44px; transform: translateX(-50%) translateY(-8px); }
  .hotspot.is-open .hotspot__card--above { transform: translateX(-50%) translateY(0); }
  @media (hover: hover) {
    .hotspot:hover .hotspot__card--above, .hotspot:focus-within .hotspot__card--above { transform: translateX(-50%) translateY(0); }
  }
  .hotspot__dot { position: relative; z-index: 2; transition: background .2s, color .2s; }
  .hotspot.is-open .hotspot__dot { background: var(--brown); color: #fff; }
  .hotspot__card-media { position: relative; width: 153.07px; height: 108px; margin: 8px auto 0; background: var(--white); display: flex; align-items: center; justify-content: center; }
  .hotspot__card-media img { width: 100%; height: 100%; object-fit: contain; }
  .hotspot__card-body { padding: 8px 10px 10px; }
  .hotspot__card-title { font-family: var(--font-ui); font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--brown); margin: 0 0 6px; }
  .hotspot__card .product-card__meta { margin: 0 0 4px; font-size: 11px; }
  .hotspot__card .product-card__price { display: block; margin: 4px 0 10px; font-size: 15px; }
  .hotspot__card .product-card__add { height: 38px; font-size: 9px; letter-spacing: .12em; }
  .hotspot__card .product-card__wish { top: 8px; right: 8px; z-index: 4; }
</style>

<script>
  /* The card is anchored centred under its dot, so a hotspot near the right
     edge of the photo pushed it past the edge of the page (21px over, on the
     75% one at 375px wide) and a hotspot low in the photo pushed it below the
     fold. Nudge it back horizontally, and flip it above the dot when there is
     no room underneath. A closed card still has a layout box -- it is only
     transparent, not display:none -- so this can measure without opening it. */
  function placeCard(hotspot) {
    var card = hotspot.querySelector('.hotspot__card');
    if (!card) return;
    card.style.marginLeft = '';
    card.classList.remove('hotspot__card--above');
    var pad = 10;
    var r = card.getBoundingClientRect();
    var shift = 0;
    if (r.right > window.innerWidth - pad) shift = (window.innerWidth - pad) - r.right;
    else if (r.left < pad) shift = pad - r.left;
    if (shift) card.style.marginLeft = Math.round(shift) + 'px';
    /* Only flip if there is actually more room above than below, or the card
       just moves from off the bottom to off the top. */
    if (r.bottom > window.innerHeight && r.height + 44 < hotspot.getBoundingClientRect().top) {
      card.classList.add('hotspot__card--above');
    }
  }

  document.querySelectorAll('.sleepscape [data-hotspot]').forEach(function (hotspot) {
    var toggle = hotspot.querySelector('[data-hotspot-toggle]');
    if (!toggle) return;
    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      var wasOpen = hotspot.classList.contains('is-open');
      document.querySelectorAll('.sleepscape .hotspot.is-open').forEach(function (h) { h.classList.remove('is-open'); });
      if (!wasOpen) {
        placeCard(hotspot);
        hotspot.classList.add('is-open');
      }
    });
    /* Hover and keyboard focus reveal the card via CSS alone, so they need
       the same placement pass. */
    hotspot.addEventListener('pointerenter', function () { placeCard(hotspot); });
    hotspot.addEventListener('focusin', function () { placeCard(hotspot); });
  });

  window.addEventListener('resize', function () {
    document.querySelectorAll('.sleepscape .hotspot__card').forEach(function (card) {
      card.style.marginLeft = '';
      card.classList.remove('hotspot__card--above');
    });
  });
  document.addEventListener('click', function () {
    document.querySelectorAll('.sleepscape .hotspot.is-open').forEach(function (h) { h.classList.remove('is-open'); });
  });
</script>

{% schema %}
{
  "name": "Sleepscape",
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Build your <em>sleepscape</em>" },
    { "type": "richtext", "id": "subtext", "label": "Subheading", "default": "<p>Tap a piece to add it — build the layered look in one go.</p>" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "header_spacing", "label": "Header spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#5a5148" },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#8c8275" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "select", "id": "subheading_font", "label": "Subheading font", "default": "sans", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "section_padding_top", "label": "Padding top", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "section_padding_bottom", "label": "Padding bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 90 },
    { "type": "header", "content": "Room" },
    { "type": "image_picker", "id": "image", "label": "Room image" },
    { "type": "range", "id": "image_radius", "label": "Image border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "image_border_width", "label": "Image border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "image_border_color", "label": "Image border color", "default": "#5a5148" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Ivory · 2N Pillow Covers" },
        { "type": "range", "id": "x", "label": "Horizontal %", "min": 0, "max": 100, "step": 1, "default": 40 },
        { "type": "range", "id": "y", "label": "Vertical %", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [
    { "name": "Sleepscape", "blocks": [ { "type": "hotspot", "settings": { "x": 35, "y": 55 } }, { "type": "hotspot", "settings": { "x": 62, "y": 40 } } ] }
  ]
}
{% endschema %}
