<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 260 }}" alt="{{ shop.name }}" class="footer-brand__logo-img" width="300" height="200">
        {%- else -%}
          <img src="{{ 'logo.png.jpeg' | asset_url }}" alt="{{ shop.name }}" class="footer-brand__logo-img" width="300" height="200">
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <p class="footer-label">Corporate Office</p>
          <p class="footer-text">{{ section.settings.address }}</p>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <p class="footer-label">Email ID</p>
          <p class="footer-text">{{ section.settings.email }}</p>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <p class="footer-label">Contact No.</p>
          <p class="footer-text"><a href="tel:{{ section.settings.phone | remove: ' ' }}"><u>{{ section.settings.phone }}</u></a></p>
        {%- endif -%}
      </div>

      <div class="footer-cols">
        {%- for block in section.blocks -%}
          {%- comment -%}
            <details open> so the links are expanded for everyone by default.
            The phone accordion is progressive enhancement: footer.js closes
            these below the breakpoint, so with JS off nothing is hidden and
            the footer behaves exactly as it did before. On desktop the
            summary is made unclickable in CSS so it cannot be collapsed.
          {%- endcomment -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <details class="footer-col__acc" open>
              <summary class="footer-col__title">
                {{ block.settings.title }}
                <svg class="footer-col__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="footer-col__links">
                {%- assign links = block.settings.menu -%}
                {%- if links != blank and linklists[links] -%}
                  {%- for link in linklists[links].links -%}
                    <a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign items = block.settings.items | split: "
" -%}
                  {%- for item in items -%}
                    {%- assign parts = item | strip | split: '|' -%}
                    {%- if parts[0] != blank -%}
                      <a href="{{ parts[1] | default: '#' | strip }}" class="footer-col__link">{{ parts[0] | strip }}</a>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </details>
          </div>
        {%- endfor -%}
      </div>

      <div class="footer-social">
        {%- if section.settings.linkedin != blank -%}<a href="{{ section.settings.linkedin }}" aria-label="LinkedIn">{% render 'icon', icon: 'linkedin' %}</a>{%- endif -%}
        {%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook">{% render 'icon', icon: 'facebook' %}</a>{%- endif -%}
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a>{%- endif -%}
        {%- if settings.whatsapp_number != blank -%}<a href="https://wa.me/{{ settings.whatsapp_number }}" aria-label="WhatsApp">{% render 'icon', icon: 'whatsapp' %}</a>{%- endif -%}
      </div>
    </div>

    {%- if section.settings.seo_text != blank -%}
      <div class="footer-seo"><p>{{ section.settings.seo_text }}</p></div>
    {%- endif -%}

    <p class="footer-copy">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--cream); padding: 70px 0 40px; margin-top: 20px; }
  .footer-top { display: grid; grid-template-columns: 1.3fr 3fr auto; gap: 40px; }
  .footer-brand__logo-img { height: 54px; width: auto; display: block; }
  .footer-brand .logo-mark { font-family: var(--font-serif); font-size: 26px; color: var(--brown); }
  .footer-brand .logo-mark em { font-style: italic; }
  .footer-brand .logo-mark small { display: block; font-family: var(--font-ui); font-size: 9px; letter-spacing: .25em; text-transform: uppercase; color: var(--taupe); }
  .footer-label { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin: 22px 0 6px; }
  .footer-text { font-size: 14px; color: var(--brown-2); margin: 0; max-width: 260px; line-height: 1.6; }
  .footer-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  /* <summary> defaults to display:list-item, which draws the disclosure
     triangle; flex removes it without needing the vendor-prefixed marker
     rules. The chevron only ever shows at phone widths. */
  .footer-col__title { display: flex; align-items: center; justify-content: space-between; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--brown); margin: 0 0 12px; list-style: none; }
  .footer-col__title::-webkit-details-marker { display: none; }
  .footer-col__chev { width: 16px; height: 16px; flex: none; display: none; transition: transform .25s; }
  /* Not collapsible above the breakpoint: the columns are meant to be open
     side by side there, and <details open> would otherwise let a click on
     the heading shut one. */
  .footer-col__acc > .footer-col__title { pointer-events: none; cursor: default; }
  /* The 12px that used to sit between links as dead margin is now 6px of
     padding on each link instead, so the tap box is the full 34px pitch
     rather than just the 22px line box -- these sit in a dense stack on
     phones and the gaps between them were as tall as the targets. The
     title's margin drops by the same 6px so the first link's text stays
     exactly where it was and the pitch is unchanged; the column ends 6px
     shorter where the last link's margin used to be, which the footer's
     own padding absorbs. */
  .footer-col__link { display: block; font-size: 14px; color: var(--muted); padding: 6px 0; margin-bottom: 0; transition: color .2s; }
  .footer-col__link:hover { color: var(--brown); }
  /* Same gap-into-padding trade as the link stack: the 16px gaps become
     8px of padding per icon, so each icon is a 34x42 target instead of an
     18x26 one while the 34px pitch and the row's visual position stay put
     (the negative margin cancels the padding the row would otherwise add
     around the outside). */
  .footer-social { display: flex; gap: 0; margin: -8px; color: var(--brown); height: fit-content; }
  .footer-social a { padding: 8px; display: inline-flex; transition: color .2s; }
  .footer-social a:hover { color: var(--taupe); }
  .footer-seo { border-top: 1px solid var(--line); margin-top: 50px; padding-top: 30px; }
  .footer-seo p { font-size: 13px; color: var(--muted); line-height: 1.8; margin: 0; }
  .footer-copy { text-align: center; font-size: 13px; color: var(--muted); margin: 40px 0 0; letter-spacing: .04em; }

  @media (max-width: 990px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); }
    .footer-social { margin-top: 10px; }
  }

  /* Phone: the footer was 1494px -- close to two full screens -- and 590px of
     that was the four link columns sitting open in a 2x2 grid. They become
     one full-width accordion each (~44px collapsed), which is both the
     shorter and the more familiar mobile footer. Every link keeps its 34px
     tap pitch once a section is open.

     The rest is spacing: the footer's own 70/40 padding, the 40px gaps in
     .footer-top, the 22px above each address label, and the 50+30 and 40 of
     margin before the SEO text and the copyright line. Nothing is removed --
     the links are a tap away and every word of copy is still there. */
  @media (max-width: 700px) {
    .site-footer { padding: 40px 0 28px; }
    .footer-top { gap: 28px; }
    .footer-label { margin-top: 14px; }
    .footer-cols { grid-template-columns: 1fr; gap: 0; }
    .footer-col { border-top: 1px solid var(--line); }
    .footer-col:last-child { border-bottom: 1px solid var(--line); }
    .footer-col__title { margin: 0; padding: 14px 0; cursor: pointer; }
    /* Overrides the desktop lock above so the heading is tappable again. */
    .footer-col__acc > .footer-col__title { pointer-events: auto; }
    .footer-col__chev { display: block; }
    .footer-col__acc[open] > .footer-col__title .footer-col__chev { transform: rotate(180deg); }
    .footer-col__links { padding-bottom: 8px; }
    .footer-seo { margin-top: 24px; padding-top: 20px; }
    .footer-copy { margin-top: 24px; }
  }
</style>

<script>
  /* The columns ship as <details open>, so with JS off nothing in the footer
     is hidden. This closes them only at phone widths, where the CSS above
     turns each one into a full-width tappable bar. Re-evaluated on resize,
     but a section the visitor opened themselves is left alone so it does not
     snap shut under them on an address-bar resize or an orientation change. */
  (function () {
    var mq = window.matchMedia('(max-width: 700px)');
    var accs = document.querySelectorAll('.site-footer .footer-col__acc');
    if (!accs.length) return;

    /* Keyed off a click on the heading rather than the `toggle` event: the
       spec queues `toggle` as a task, so it arrives after this function has
       returned and every programmatic open below would look like a visitor
       action. A click on the summary only ever comes from the visitor. */
    accs.forEach(function (acc) {
      var sum = acc.querySelector('summary');
      if (sum) sum.addEventListener('click', function () { acc.dataset.userSet = '1'; });
    });

    function sync() {
      accs.forEach(function (acc) {
        if (acc.dataset.userSet) return;
        acc.open = !mq.matches;
      });
    }
    sync();
    if (mq.addEventListener) mq.addEventListener('change', sync);
  })();
</script>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "address", "label": "Address", "default": "Thakor Industrial Estate, Premier Road, Khalai Village, Vidyavihar West, Vidyavihar, Mumbai, Maharashtra 400086" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@sarom.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "088289 11111" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "textarea", "id": "seo_text", "label": "SEO paragraph", "default": "Beds & More is a premium bedding brand from Sarom Fab offering 100% cotton, OEKO-TEX® Standard 100 certified knitted bedcover sets, cosy throws and textured cushion covers in India. The EARTHEN Knitscape collection comes in nine natural shades — in King size (96 × 108 in) with matching pillow covers. Soft, fluffy, breathable, machine washable, with no colour bleeding and free shipping & Cash on Delivery across India." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "Beds & More by Sarom Fab · Made in India" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "link_list", "id": "menu", "label": "Menu (optional)" },
        { "type": "textarea", "id": "items", "label": "Manual links (Label|/url per line)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "column", "settings": { "title": "Shop", "items": "Bedsheets|/collections/bedsheets\nBed Covers|/collections/bed-covers\nPillow Covers|/collections/pillow-covers\nComforters|/collections/comforters\nThrows|/collections/throws\nPillows|/collections/pillows" } },
      { "type": "column", "settings": { "title": "Collections", "items": "Bare Earth|/collections/bare-earth\nPlush|/collections/plush\nTerraweave|/collections/terraweave\nSoft Haven|/collections/soft-haven\nKnitscapes|/collections/knitscapes" } },
      { "type": "column", "settings": { "title": "Corporate", "items": "Corporate|/pages/corporate\nHotels & Resorts|/pages/corporate\nDesigners & Architects|/pages/corporate\nDevelopers|/pages/corporate\nRetail Partners|/pages/corporate" } },
      { "type": "column", "settings": { "title": "Company", "items": "About us|/pages/about-us\nJournal|/blogs/journal\nFAQ's|/pages/faq" } }
    ]
  }
}
{% endschema %}
