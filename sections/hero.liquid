<section class="hero">
  <div class="hero__media" style="margin-top:{{ section.settings.image_margin_top }}px;border-radius:{{ section.settings.image_radius }}px;border:{{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }}">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.heading | escape }}" width="2400" height="1200" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {%- endif -%}
    <div class="hero__scrim"></div>
    <button class="round-btn hero__next" aria-label="Explore" data-hero-next>{% render 'icon', icon: 'arrow-right' %}</button>

    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero__eyebrow" style="font-size:{{ section.settings.eyebrow_size }}px;color:{{ section.settings.eyebrow_color }};font-family:var(--font-{{ section.settings.eyebrow_font }})">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero__title" style="font-size:clamp({{ section.settings.heading_size | times: 0.48 | round }}px, 7vw, {{ section.settings.heading_size }}px);color:{{ section.settings.heading_color }};font-family:var(--font-{{ section.settings.heading_font }})">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="hero__text" style="font-size:{{ section.settings.text_size }}px;margin-top:{{ section.settings.header_spacing }}px;color:{{ section.settings.text_color }};font-family:var(--font-{{ section.settings.text_font }})">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label_1 != blank -%}
          <a class="btn" href="{{ section.settings.button_link_1 }}">{{ section.settings.button_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_trust -%}
    <div class="trust-bar">
      {%- assign items = section.settings.trust_items | split: '|' -%}
      {%- assign trust_icons = 'box|refresh|cash|truck' | split: '|' -%}
      {%- for item in items -%}
        <span class="trust-bar__item">
          {%- assign icon_index = forloop.index0 | modulo: trust_icons.size -%}
          {% render 'icon', icon: trust_icons[icon_index] %}
          {{ item | strip }}
        </span>
        {%- unless forloop.last -%}<span class="trust-bar__sep"></span>{%- endunless -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  .hero { position: relative; }
  .hero__media {
    position: relative;
    width: calc(100% - (var(--gutter) * 2)); /* same box-sizing formula as the header's .container */
    max-width: var(--container);
    aspect-ratio: 1152 / 565;     /* scales height proportionally as width shrinks */
    max-height: calc(100svh - 120px); /* keeps the whole card (incl. bottom pill) on screen under the header */
    margin: 24px auto 0;
    border-radius: 20px;
    overflow: hidden;
  }
  .hero__media img, .hero__placeholder { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(244,238,228,.82) 0%, rgba(244,238,228,.5) 45%, rgba(244,238,228,.1) 100%); }
  .hero__content { position: absolute; inset: 0; padding-left: 64px; padding-right: 40px; display: flex; flex-direction: column; justify-content: center; }
  @media (max-width: 700px){
    /* Fixed aspect-ratio + overflow:hidden clipped the stacked eyebrow/heading/text/buttons on
       narrow screens (measured content height ~300px vs a ~160px tall 1152:565 card at 375px
       viewport). Let the card grow to fit its content on mobile instead of clipping it: the image
       becomes an absolutely-positioned cover layer and .hero__content flows normally, pushing the
       card's height (min-height keeps it from ever going too short). */
    .hero__media { aspect-ratio: unset; max-height: none; min-height: 420px; }
    .hero__media img, .hero__media .hero__placeholder { position: absolute; inset: 0; }
    .hero__content { position: relative; padding: 44px 28px 72px; justify-content: flex-start; }
  }
  .hero__eyebrow { color: var(--taupe-dark); }
  .hero__title { font-size: clamp(44px, 7vw, 92px); color: var(--brown-2); line-height: 1; max-width: 12ch; }
  .hero__title em { font-style: italic; color: var(--taupe); }
  .hero__text { color: var(--brown-2); max-width: 42ch; margin: 20px 0 0; font-size: 16px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 34px; }
  .hero__actions .btn--outline { border-color: var(--brown); color: var(--brown); }
  .hero__actions .btn--outline:hover { background: var(--brown); color: #fff; }
  .hero__next { position: absolute; top: 50%; right: 40px; transform: translateY(-50%); z-index: 2; background: transparent; border-color: var(--brown); color: var(--brown); }
  .hero__next:hover { background: var(--brown); color: #fff; border-color: var(--brown); }
  @media (max-width: 700px){ .hero__next { display: none; } }
  .trust-bar {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 50%); /* straddles the card's bottom edge -- half on the image, half below it */
    z-index: 2;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 40px;
    width: max-content;
    max-width: calc(100% - 32px);
    background: var(--cream);
    border-radius: 100px;
    padding: 8px 22px;
    box-shadow: 0 6px 20px rgba(0,0,0,.08);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .trust-bar::-webkit-scrollbar { display: none; }
  .trust-bar__item { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 12px; line-height: 1.2; color: var(--brown-2); white-space: nowrap; flex-shrink: 0; }
  .trust-bar__item svg { flex-shrink: 0; width: 15px; height: 15px; color: var(--taupe-dark); }
  .trust-bar__sep { display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: var(--taupe); flex-shrink: 0; }
  @media (max-width: 700px){ .trust-bar { flex-wrap: wrap; white-space: normal; gap: 6px 14px; padding: 10px 14px; } .trust-bar__item { font-size: 11px; } }
</style>

<script>
  document.querySelectorAll('[data-hero-next]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var wrap = btn.closest('.shopify-section');
      var next = wrap ? wrap.nextElementSibling : null;
      if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "header", "content": "Section header" },
    { "type": "inline_richtext", "id": "eyebrow", "label": "Eyebrow text", "default": "Bespoke Bedding · 100% Cotton · Exquisite Craftsmanship" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The art of <em>sleep.</em>" },
    { "type": "richtext", "id": "text", "label": "Subheading", "default": "<p>Designed to transform your bedroom into a quiet sanctuary of restful serenity.</p>" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 60, "max": 120, "step": 2, "unit": "px", "default": 92 },
    { "type": "range", "id": "text_size", "label": "Subheading size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "header_spacing", "label": "Header spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#8d7c67" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#57534a" },
    { "type": "color", "id": "text_color", "label": "Subheading color", "default": "#57534a" },
    { "type": "select", "id": "eyebrow_font", "label": "Eyebrow font", "default": "ui", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "serif", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "select", "id": "text_font", "label": "Subheading font", "default": "sans", "options": [ { "value": "serif", "label": "Serif (Fraunces)" }, { "value": "sans", "label": "Sans (Mulish)" }, { "value": "ui", "label": "UI label (Outfit)" } ] },
    { "type": "header", "content": "Image style" },
    { "type": "range", "id": "image_radius", "label": "Image border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "image_border_width", "label": "Image border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "image_border_color", "label": "Image border color", "default": "#5a5148" },
    { "type": "range", "id": "image_margin_top", "label": "Image margin top", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label_1", "label": "Button 1 label", "default": "Shop by category" },
    { "type": "url", "id": "button_link_1", "label": "Button 1 link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 label", "default": "Featured collections" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 link" },
    { "type": "header", "content": "Trust bar" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust bar", "default": true },
    { "type": "text", "id": "trust_items", "label": "Items (separate with |)", "default": "Free delivery | 7 day returns | Cash on delivery available | Delivered in 48 hours" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
